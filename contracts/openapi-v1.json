{
  "openapi": "3.1.0",
  "info": {
    "title": "Padrão de Laudos Periciais — Product API",
    "version": "1.1.0",
    "description": "Contrato mínimo da API local do produto.",
    "x-semantic-boundary": "scripts.backend_contract.api_contract.parse_judicial_domain_payload",
    "x-case-analysis-semantic-boundary": "scripts.backend_contract.case_analysis.case_analysis_from_mapping"
  },
  "paths": {
    "/v1/workspaces/{workspace_id}/case-analysis": {
      "get": {
        "summary": "Reabre a análise canônica",
        "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}],
        "responses": {
          "200": {"description": "Análise revalidada", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CaseAnalysisEnvelope"}}}},
          "404": {"description": "Análise ausente"}
        }
      },
      "post": {
        "summary": "Salva nova revisão canônica",
        "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SaveCaseAnalysisRequest"}}}},
        "responses": {
          "200": {"description": "Revisão persistida", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CaseAnalysisEnvelope"}}}},
          "409": {"description": "Conflito de revisão"}
        }
      }
    }
  },
  "components": {
    "parameters": {
      "WorkspaceId": {"name": "workspace_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}
    },
    "schemas": {
      "ProceduralContext": {"$ref": "../schemas/judicial-domain-model-v1.schema.json"},
      "CaseAnalysisSnapshot": {"$ref": "../schemas/case-analysis-snapshot-v1.schema.json"},
      "SaveCaseAnalysisRequest": {
        "type": "object",
        "required": ["expected_revision", "snapshot"],
        "properties": {
          "expected_revision": {"type": ["integer", "null"], "minimum": 1},
          "snapshot": {"$ref": "#/components/schemas/CaseAnalysisSnapshot"}
        },
        "additionalProperties": false
      },
      "CaseAnalysisEnvelope": {
        "type": "object",
        "required": ["revision", "updated_at", "snapshot"],
        "properties": {
          "revision": {"type": "integer", "minimum": 1},
          "updated_at": {"type": "string"},
          "snapshot": {"$ref": "#/components/schemas/CaseAnalysisSnapshot"}
        },
        "additionalProperties": false
      }
    }
  }
}
