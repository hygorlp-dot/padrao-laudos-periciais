{
  "openapi": "3.1.0",
  "info": {
    "title": "Padrão de Laudos Periciais — Product API",
    "version": "1.1.0",
    "description": "Contrato mínimo da API local do produto.",
    "x-semantic-boundary": "scripts.backend_contract.api_contract.parse_judicial_domain_payload",
    "x-case-analysis-semantic-boundary": "scripts.backend_contract.case_analysis.case_analysis_from_mapping",
    "x-pericial-planning-semantic-boundary": "scripts.backend_contract.pericial_planning.pericial_planning_from_mapping",
    "x-inspection-session-semantic-boundary": "scripts.backend_contract.vistoria.inspection_session_from_mapping",
    "x-technical-snapshot-semantic-boundary": "scripts.backend_contract.technical_findings.technical_snapshot_from_mapping",
    "x-report-snapshot-semantic-boundary": "scripts.backend_contract.report_foundation.report_snapshot_from_mapping",
    "x-delivery-snapshot-semantic-boundary": "scripts.backend_contract.delivery_foundation.delivery_snapshot_from_mapping"
  },
  "paths": {
    "/v1/workspaces/{workspace_id}/case-analysis": {
      "get": {
        "summary": "Reabre a análise canônica",
        "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}],
        "responses": {
          "200": {"description": "Análise revalidada", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CaseAnalysisEnvelope"}}}},
          "404": {"description": "Análise ausente"}
        }
      },
      "post": {
        "summary": "Salva nova revisão canônica",
        "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SaveCaseAnalysisRequest"}}}},
        "responses": {
          "200": {"description": "Revisão persistida", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CaseAnalysisEnvelope"}}}},
          "409": {"description": "Conflito de revisão"}
        }
      }
    },
    "/v1/workspaces/{workspace_id}/pericial-planning": {
      "get": {
        "summary": "Reabre o planejamento pericial canônico",
        "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}],
        "responses": {
          "200": {"description": "Planejamento reconciliado", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PericialPlanningEnvelope"}}}},
          "404": {"description": "Planejamento ausente"}
        }
      },
      "put": {
        "summary": "Salva nova revisão de planejamento",
        "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SavePericialPlanningRequest"}}}},
        "responses": {
          "200": {"description": "Revisão persistida", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PericialPlanningEnvelope"}}}},
          "409": {"description": "Conflito de revisão"}
        }
      }
    },
    "/v1/workspaces/{workspace_id}/inspection-photos": {
      "post": {
        "summary": "Preserva fotografia original privada JPEG ou PNG",
        "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}, {"name":"X-Document-Filename","in":"header","required":true,"schema":{"type":"string","minLength":1,"maxLength":1024}}],
        "requestBody": {"required":true,"content":{"image/jpeg":{"schema":{"type":"string","format":"binary"}},"image/png":{"schema":{"type":"string","format":"binary"}}}},
        "responses": {"201":{"description":"Original privado preservado","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PrivatePhotoMetadata"}}}}}
      }
    },
    "/v1/workspaces/{workspace_id}/inspection-session": {
      "get": {
        "summary": "Reabre a sessão canônica de vistoria",
        "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}],
        "responses": {"200": {"description": "Sessão reconciliada", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/InspectionSessionEnvelope"}}}}, "404": {"description": "Sessão ausente"}}
      },
      "put": {
        "summary": "Salva nova revisão de vistoria vinculada ao planejamento aprovado",
        "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SaveInspectionSessionRequest"}}}},
        "responses": {"200": {"description": "Revisão persistida", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/InspectionSessionEnvelope"}}}}, "409": {"description": "Conflito ou planejamento stale"}}
      },
      "post": {
        "summary": "Inicia sessão pendente a partir do planejamento aprovado atual",
        "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/StartInspectionSessionRequest"}}}},
        "responses": {"201": {"description": "Sessão inicial persistida", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/InspectionSessionEnvelope"}}}}, "409": {"description": "Planejamento indisponível ou stale"}}
      }
    },
    "/v1/workspaces/{workspace_id}/technical-snapshot": {
      "get": {
        "summary": "Reabre a cadeia técnica canônica reconciliada",
        "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}],
        "responses": {"200": {"description": "Cadeia técnica reconciliada", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TechnicalSnapshotEnvelope"}}}}, "404": {"description": "Cadeia técnica ausente"}}
      },
      "post": {
        "summary": "Inicia cadeia técnica vazia vinculada aos upstreams atuais",
        "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"type":"object","additionalProperties":false}}}},
        "responses": {"201": {"description": "Cadeia técnica inicial persistida", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TechnicalSnapshotEnvelope"}}}}, "409": {"description": "Upstream ausente ou stale"}}
      },
      "put": {
        "summary": "Salva revisão da cadeia técnica com autoridade profissional explícita",
        "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SaveTechnicalSnapshotRequest"}}}},
        "responses": {"200": {"description": "Revisão técnica persistida", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TechnicalSnapshotEnvelope"}}}}, "409": {"description": "Conflito de revisão ou upstream stale"}}
      }
    },
    "/v1/workspaces/{workspace_id}/expert-profile": {
      "get": {"summary":"Reabre o perfil mestre do perito","parameters":[{"$ref":"#/components/parameters/WorkspaceId"}],"responses":{"200":{"description":"Perfil mestre atual","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ExpertProfileEnvelope"}}}},"404":{"description":"Perfil ausente"}}},
      "put": {"summary":"Salva uma revisão explícita do perfil mestre","parameters":[{"$ref":"#/components/parameters/WorkspaceId"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/SaveExpertProfileRequest"}}}},"responses":{"200":{"description":"Perfil persistido","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ExpertProfileEnvelope"}}}},"409":{"description":"Conflito de revisão"}}}
    },
    "/v1/workspaces/{workspace_id}/report-snapshot": {
      "get": {"summary":"Reabre o laudo canônico reconciliado","parameters":[{"$ref":"#/components/parameters/WorkspaceId"}],"responses":{"200":{"description":"Laudo reconciliado","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ReportSnapshotEnvelope"}}}},"404":{"description":"Laudo ausente"}}},
      "post": {"summary":"Inicia laudo vinculado às autoridades atuais","parameters":[{"$ref":"#/components/parameters/WorkspaceId"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false}}}},"responses":{"201":{"description":"Rascunho inicial persistido","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ReportSnapshotEnvelope"}}}},"409":{"description":"Upstream ausente ou stale"}}},
      "put": {"summary":"Salva revisão do laudo sem promover autoridade","parameters":[{"$ref":"#/components/parameters/WorkspaceId"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/SaveReportSnapshotRequest"}}}},"responses":{"200":{"description":"Revisão persistida","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ReportSnapshotEnvelope"}}}},"409":{"description":"Conflito ou upstream stale"}}}
    },
    "/v1/workspaces/{workspace_id}/report-snapshot/reviews": {
      "post": {"summary":"Registra revisão profissional linear e explícita","parameters":[{"$ref":"#/components/parameters/WorkspaceId"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ReportReviewRequest"}}}},"responses":{"200":{"description":"Decisão profissional persistida","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ReportSnapshotEnvelope"}}}},"409":{"description":"Conflito, autoridade ou upstream stale"}}}
    },
    "/v1/workspaces/{workspace_id}/report-snapshot/draft-amendments": {
      "post": {"summary":"Altera rascunho por comando canônico rastreável","parameters":[{"$ref":"#/components/parameters/WorkspaceId"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ReportDraftAmendmentRequest"}}}},"responses":{"200":{"description":"Rascunho validado e persistido","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ReportSnapshotEnvelope"}}}},"409":{"description":"Conflito, revisão existente ou fonte inválida"}}}
    },
    "/v1/workspaces/{workspace_id}/delivery-templates": {
      "post":{"summary":"Preserva template DOCX/DOCM no armazenamento privado","parameters":[{"$ref":"#/components/parameters/WorkspaceId"},{"name":"X-Document-Filename","in":"header","required":true,"schema":{"type":"string","minLength":1}}],"requestBody":{"required":true,"content":{"application/vnd.openxmlformats-officedocument.wordprocessingml.document":{"schema":{"type":"string","format":"binary"}},"application/vnd.ms-word.document.macroEnabled.12":{"schema":{"type":"string","format":"binary"}}}},"responses":{"201":{"description":"Template privado preservado"}}}
    },
    "/v1/workspaces/{workspace_id}/delivery-snapshot": {
      "get":{"summary":"Reabre e reconcilia a entrega canônica","parameters":[{"$ref":"#/components/parameters/WorkspaceId"}],"responses":{"200":{"description":"Entrega reconciliada","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DeliverySnapshotEnvelope"}}}},"404":{"description":"Entrega ausente"}}},
      "post":{"summary":"Inicia entrega vinculada ao laudo aprovado e template privado","parameters":[{"$ref":"#/components/parameters/WorkspaceId"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/StartDeliveryRequest"}}}},"responses":{"201":{"description":"Entrega em rascunho","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DeliverySnapshotEnvelope"}}}},"409":{"description":"Autoridade ausente ou stale"}}}
    },
    "/v1/workspaces/{workspace_id}/delivery-snapshot/render": {"post":{"summary":"Renderiza DOCX/DOCM e PDF candidatos sem finalizar","parameters":[{"$ref":"#/components/parameters/WorkspaceId"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DeliveryRenderRequest"}}}},"responses":{"200":{"description":"Bytes privados renderizados","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DeliverySnapshotEnvelope"}}}}}}},
    "/v1/workspaces/{workspace_id}/delivery-snapshot/reviews": {"post":{"summary":"Registra revisão ou aprovação profissional explícita","parameters":[{"$ref":"#/components/parameters/WorkspaceId"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DeliveryDecisionRequest"}}}},"responses":{"200":{"description":"Decisão persistida","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DeliverySnapshotEnvelope"}}}}}}},
    "/v1/workspaces/{workspace_id}/delivery-snapshot/finalize": {"post":{"summary":"Reabre, verifica hashes e finaliza explicitamente","parameters":[{"$ref":"#/components/parameters/WorkspaceId"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DeliveryFinalRequest"}}}},"responses":{"200":{"description":"Entrega finalizada e verificada","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DeliverySnapshotEnvelope"}}}}}}},
    "/v1/workspaces/{workspace_id}/delivery-snapshot/deliver": {"post":{"summary":"Registra entrega profissional explícita","parameters":[{"$ref":"#/components/parameters/WorkspaceId"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DeliveryFinalRequest"}}}},"responses":{"200":{"description":"Entrega registrada","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DeliverySnapshotEnvelope"}}}}}}},
    "/v1/workspaces/{workspace_id}/delivery-snapshot/reissue": {"post":{"summary":"Cria nova revisão após supersessão explícita","parameters":[{"$ref":"#/components/parameters/WorkspaceId"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ReissueDeliveryRequest"}}}},"responses":{"200":{"description":"Nova revisão em rascunho","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DeliverySnapshotEnvelope"}}}}}}},
    "/v1/workspaces/{workspace_id}/delivery-snapshot/artifacts/{content_id}": {"get":{"summary":"Baixa bytes privados presentes no manifesto atual","parameters":[{"$ref":"#/components/parameters/WorkspaceId"},{"name":"content_id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Artefato cuja integridade consta do manifesto","content":{"application/pdf":{"schema":{"type":"string","format":"binary"}},"application/vnd.openxmlformats-officedocument.wordprocessingml.document":{"schema":{"type":"string","format":"binary"}},"application/vnd.ms-word.document.macroEnabled.12":{"schema":{"type":"string","format":"binary"}}}},"404":{"description":"Artefato fora do manifesto"}}}},
    "/v1/workspaces/{workspace_id}/pericial-planning/decisions": {
      "post": {
        "summary": "Registra decisão profissional explícita sobre uma proposta",
        "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PericialPlanningDecisionRequest"}}}},
        "responses": {
          "200": {"description": "Decisão anexada sem substituir a proposta", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PericialPlanningEnvelope"}}}},
          "409": {"description": "Conflito de revisão ou upstream stale"}
        }
      }
    }
  },
  "components": {
    "parameters": {
      "WorkspaceId": {"name": "workspace_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}
    },
    "schemas": {
      "ProceduralContext": {"$ref": "../schemas/judicial-domain-model-v1.schema.json"},
      "CaseAnalysisSnapshot": {"$ref": "../schemas/case-analysis-snapshot-v1.schema.json"},
      "PericialPlanningSnapshot": {"$ref": "../schemas/pericial-planning-snapshot-v1.schema.json"},
      "InspectionSession": {"$ref": "../schemas/inspection-session-v1.schema.json"},
      "TechnicalSnapshot": {"$ref": "../schemas/technical-snapshot-v1.schema.json"},
      "ReportSnapshot": {"$ref": "../schemas/report-snapshot-v1.schema.json"},
      "DeliverySnapshot": {"$ref": "../schemas/delivery-snapshot-v1.schema.json"},
      "TemplateManifest": {"type":"object","additionalProperties":false,"required":["schema_version","template_id","output_kind","bindings"],"properties":{"schema_version":{"const":"1.0.0"},"template_id":{"type":"string","minLength":1},"output_kind":{"enum":["DOCX","DOCM"]},"bindings":{"type":"array","minItems":3,"maxItems":3,"items":{"type":"object","additionalProperties":false,"required":["field","placeholder"],"properties":{"field":{"enum":["EXPERT_FULL_NAME","EXPERT_REGISTRATION","REPORT_ID"]},"placeholder":{"type":"string","minLength":1}}}}}},
      "StartDeliveryRequest": {"type":"object","additionalProperties":false,"required":["template_content_id","manifest","rendering_version"],"properties":{"template_content_id":{"type":"string","format":"uuid"},"manifest":{"$ref":"#/components/schemas/TemplateManifest"},"rendering_version":{"type":"string","minLength":1}}},
      "DeliveryRenderRequest": {"type":"object","additionalProperties":false,"required":["expected_revision","manifest"],"properties":{"expected_revision":{"type":"integer","minimum":1},"manifest":{"$ref":"#/components/schemas/TemplateManifest"}}},
      "DeliveryDecisionRequest": {"type":"object","additionalProperties":false,"required":["expected_revision","action","professional_id","reason"],"properties":{"expected_revision":{"type":"integer","minimum":1},"action":{"enum":["MARK_READY_FOR_REVIEW","APPROVE","SUPERSEDE"]},"professional_id":{"type":"string","minLength":1},"reason":{"type":"string","minLength":1}}},
      "DeliveryFinalRequest": {"type":"object","additionalProperties":false,"required":["expected_revision","professional_id","reason"],"properties":{"expected_revision":{"type":"integer","minimum":1},"professional_id":{"type":"string","minLength":1},"reason":{"type":"string","minLength":1}}},
      "ReissueDeliveryRequest": {"type":"object","additionalProperties":false,"required":["expected_revision","template_content_id","manifest","rendering_version"],"properties":{"expected_revision":{"type":"integer","minimum":1},"template_content_id":{"type":"string","format":"uuid"},"manifest":{"$ref":"#/components/schemas/TemplateManifest"},"rendering_version":{"type":"string","minLength":1}}},
      "DeliverySnapshotEnvelope": {"type":"object","additionalProperties":false,"required":["revision","updated_at","snapshot"],"properties":{"revision":{"type":"integer","minimum":1},"updated_at":{"type":"string","format":"date-time"},"snapshot":{"$ref":"#/components/schemas/DeliverySnapshot"}}},
      "ExpertProfile": {"type":"object","additionalProperties":false,"required":["profile_id","revision","full_name","professional_title","registration","court_registration","contact_line"],"properties":{"profile_id":{"type":"string","minLength":1},"revision":{"type":"integer","minimum":1},"full_name":{"type":"string","minLength":1},"professional_title":{"type":"string","minLength":1},"registration":{"type":"string","minLength":1},"court_registration":{"type":"string","minLength":1},"contact_line":{"type":"string","minLength":1}}},
      "SaveExpertProfileRequest": {"type":"object","additionalProperties":false,"required":["expected_revision","profile"],"properties":{"expected_revision":{"type":["integer","null"],"minimum":1},"profile":{"$ref":"#/components/schemas/ExpertProfile"}}},
      "ExpertProfileEnvelope": {"type":"object","additionalProperties":false,"required":["revision","updated_at","profile"],"properties":{"revision":{"type":"integer","minimum":1},"updated_at":{"type":"string","format":"date-time"},"profile":{"$ref":"#/components/schemas/ExpertProfile"}}},
      "SaveReportSnapshotRequest": {"type":"object","additionalProperties":false,"required":["expected_revision","snapshot"],"properties":{"expected_revision":{"type":["integer","null"],"minimum":1},"snapshot":{"$ref":"#/components/schemas/ReportSnapshot"}}},
      "ReportReviewRequest": {"type":"object","additionalProperties":false,"required":["expected_revision","action","professional_id","reason"],"properties":{"expected_revision":{"type":"integer","minimum":1},"action":{"enum":["MARK_REVIEWED","APPROVE","SUPERSEDE"]},"professional_id":{"type":"string","minLength":1},"reason":{"type":"string","minLength":1}}},
      "ReportDraftAmendmentRequest": {"type":"object","additionalProperties":false,"required":["expected_revision","action","values"],"properties":{"expected_revision":{"type":"integer","minimum":1},"action":{"enum":["ADD_CLAIM","UPDATE_CONTEXT","ADD_ANSWER"]},"values":{"type":"object"}}},
      "ReportSnapshotEnvelope": {"type":"object","additionalProperties":false,"required":["revision","updated_at","snapshot"],"properties":{"revision":{"type":"integer","minimum":1},"updated_at":{"type":"string","format":"date-time"},"snapshot":{"$ref":"#/components/schemas/ReportSnapshot"}}},
      "SaveTechnicalSnapshotRequest": {
        "type":"object","additionalProperties":false,"required":["expected_revision","snapshot"],
        "properties":{"expected_revision":{"type":["integer","null"],"minimum":1},"snapshot":{"$ref":"#/components/schemas/TechnicalSnapshot"}}
      },
      "TechnicalSnapshotEnvelope": {
        "type":"object","additionalProperties":false,"required":["revision","updated_at","snapshot"],
        "properties":{"revision":{"type":"integer","minimum":1},"updated_at":{"type":"string","format":"date-time"},"snapshot":{"$ref":"#/components/schemas/TechnicalSnapshot"}}
      },
      "PrivatePhotoMetadata": {"type":"object","additionalProperties":false,"required":["workspace_id","content_id","original_filename","byte_size","checksum_sha256","media_type","imported_at","origin"],"properties":{"workspace_id":{"type":"string","format":"uuid"},"content_id":{"type":"string","format":"uuid"},"original_filename":{"type":"string"},"byte_size":{"type":"integer","minimum":1},"checksum_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"media_type":{"enum":["image/jpeg","image/png"]},"imported_at":{"type":"string","format":"date-time"},"origin":{"const":"USER_IMPORT"}}},
      "SaveInspectionSessionRequest": {
        "type": "object", "required": ["expected_revision", "snapshot"],
        "properties": {"expected_revision": {"type": ["integer", "null"], "minimum": 1}, "snapshot": {"$ref": "#/components/schemas/InspectionSession"}},
        "additionalProperties": false
      },
      "StartInspectionSessionRequest": {
        "type": "object", "required": ["responsible_professional", "location_context", "participant_references"],
        "properties": {"responsible_professional": {"type":"string","minLength":1}, "location_context": {"type":"string","minLength":1}, "participant_references": {"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}}},
        "additionalProperties": false
      },
      "InspectionSessionEnvelope": {
        "type": "object", "required": ["revision", "updated_at", "snapshot"],
        "properties": {"revision": {"type": "integer", "minimum": 1}, "updated_at": {"type": "string"}, "snapshot": {"$ref": "#/components/schemas/InspectionSession"}},
        "additionalProperties": false
      },
      "SaveCaseAnalysisRequest": {
        "type": "object",
        "required": ["expected_revision", "snapshot"],
        "properties": {
          "expected_revision": {"type": ["integer", "null"], "minimum": 1},
          "snapshot": {"$ref": "#/components/schemas/CaseAnalysisSnapshot"}
        },
        "additionalProperties": false
      },
      "CaseAnalysisEnvelope": {
        "type": "object",
        "required": ["revision", "updated_at", "snapshot"],
        "properties": {
          "revision": {"type": "integer", "minimum": 1},
          "updated_at": {"type": "string"},
          "snapshot": {"$ref": "#/components/schemas/CaseAnalysisSnapshot"}
        },
        "additionalProperties": false
      },
      "SavePericialPlanningRequest": {
        "type": "object",
        "required": ["expected_revision", "snapshot"],
        "properties": {
          "expected_revision": {"type": ["integer", "null"], "minimum": 1},
          "snapshot": {"$ref": "#/components/schemas/PericialPlanningSnapshot"}
        },
        "additionalProperties": false
      },
      "PericialPlanningEnvelope": {
        "type": "object",
        "required": ["revision", "updated_at", "snapshot"],
        "properties": {
          "revision": {"type": "integer", "minimum": 1},
          "updated_at": {"type": "string"},
          "snapshot": {"$ref": "#/components/schemas/PericialPlanningSnapshot"}
        },
        "additionalProperties": false
      },
      "PericialPlanningDecisionRequest": {
        "type": "object",
        "required": ["expected_revision", "target_item_id", "action", "reviewer", "reason", "decided_value"],
        "properties": {
          "expected_revision": {"type": "integer", "minimum": 1},
          "target_item_id": {"type": "string", "minLength": 1},
          "action": {"enum": ["APPROVE", "REJECT", "MODIFY", "DEFER"]},
          "reviewer": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "decided_value": {"type": ["string", "null"], "maxLength": 4096}
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {"properties": {"action": {"const": "MODIFY"}}},
            "then": {"properties": {"decided_value": {"type": "string", "minLength": 1}}},
            "else": {"properties": {"decided_value": {"type": "null"}}}
          }
        ]
      }
    }
  }
}
