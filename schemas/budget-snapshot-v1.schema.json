{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"budget-snapshot-v1.schema.json","title":"Budget Snapshot V1","type":"object","additionalProperties":false,
  "required":["schema_version","budget_id","revision","workspace_id","process_id","appointment_id","items","effort_estimates","travel_estimates","third_party_estimates","expenses","proposals","proposal_revisions","court_approvals","payments","status","outstanding"],
  "properties":{
    "schema_version":{"const":"1.0.0"},"budget_id":{"type":"string","minLength":1},"revision":{"type":"integer","minimum":1},"workspace_id":{"type":"string","format":"uuid"},
    "process_id":{"type":["string","null"],"minLength":1},"appointment_id":{"type":["string","null"],"minLength":1},
    "items":{"type":"array","items":{"$ref":"#/$defs/item"}},"effort_estimates":{"type":"array","items":{"$ref":"#/$defs/effort"}},"travel_estimates":{"type":"array","items":{"$ref":"#/$defs/travel"}},"third_party_estimates":{"type":"array","items":{"$ref":"#/$defs/third"}},
    "expenses":{"type":"array","items":{"$ref":"#/$defs/expense"}},"proposals":{"type":"array","items":{"$ref":"#/$defs/proposal"}},"proposal_revisions":{"type":"array","items":{"$ref":"#/$defs/revision"}},"court_approvals":{"type":"array","items":{"$ref":"#/$defs/approval"}},"payments":{"type":"array","items":{"$ref":"#/$defs/payment"}},
    "status":{"enum":["DRAFT","PROPOSED","COURT_APPROVED","PARTIALLY_RECEIVED","RECEIVED","CLOSED"]},"outstanding":{"$ref":"#/$defs/money"}
  },
  "$defs":{
    "amount":{"type":"string","pattern":"^(0|[1-9][0-9]*)\\.[0-9]{2}$"},"currency":{"type":"string","pattern":"^[A-Z]{3}$"},"category":{"enum":["FEES","PROFESSIONAL_HOURS","TRAVEL","ASSISTANTS","EQUIPMENT","TESTS_LABORATORY","THIRD_PARTY_SERVICES","ADMINISTRATIVE_COSTS","REVISIONS","EXPENSES"]},
    "money":{"type":"object","additionalProperties":false,"required":["amount","currency"],"properties":{"amount":{"$ref":"#/$defs/amount"},"currency":{"$ref":"#/$defs/currency"}}},
    "item":{"type":"object","additionalProperties":false,"required":["item_id","category","description","quantity","unit_amount","total_amount"],"properties":{"item_id":{"type":"string"},"category":{"$ref":"#/$defs/category"},"description":{"type":"string"},"quantity":{"$ref":"#/$defs/amount"},"unit_amount":{"$ref":"#/$defs/amount"},"total_amount":{"$ref":"#/$defs/amount"}}},
    "effort":{"type":"object","additionalProperties":false,"required":["estimate_id","professional_id","estimated_hours","hourly_amount","total_amount"],"properties":{"estimate_id":{"type":"string"},"professional_id":{"type":"string"},"estimated_hours":{"$ref":"#/$defs/amount"},"hourly_amount":{"$ref":"#/$defs/amount"},"total_amount":{"$ref":"#/$defs/amount"}}},
    "travel":{"type":"object","additionalProperties":false,"required":["estimate_id","distance_km","amount_per_km","total_amount","description"],"properties":{"estimate_id":{"type":"string"},"distance_km":{"$ref":"#/$defs/amount"},"amount_per_km":{"$ref":"#/$defs/amount"},"total_amount":{"$ref":"#/$defs/amount"},"description":{"type":"string"}}},
    "third":{"type":"object","additionalProperties":false,"required":["estimate_id","provider_description","amount","currency"],"properties":{"estimate_id":{"type":"string"},"provider_description":{"type":"string"},"amount":{"$ref":"#/$defs/amount"},"currency":{"$ref":"#/$defs/currency"}}},
    "expense":{"type":"object","additionalProperties":false,"required":["expense_id","category","amount","currency","incurred_on","description"],"properties":{"expense_id":{"type":"string"},"category":{"$ref":"#/$defs/category"},"amount":{"$ref":"#/$defs/amount"},"currency":{"$ref":"#/$defs/currency"},"incurred_on":{"type":"string","format":"date"},"description":{"type":"string"}}},
    "proposal":{"type":"object","additionalProperties":false,"required":["proposal_id","revision","amount","currency","proposed_at","rationale"],"properties":{"proposal_id":{"type":"string"},"revision":{"type":"integer","minimum":1},"amount":{"$ref":"#/$defs/amount"},"currency":{"$ref":"#/$defs/currency"},"proposed_at":{"type":"string","format":"date-time"},"rationale":{"type":"string"}}},
    "revision":{"type":"object","additionalProperties":false,"required":["revision_id","proposal_id","revision","supersedes_revision_id","reason","revised_at"],"properties":{"revision_id":{"type":"string"},"proposal_id":{"type":"string"},"revision":{"type":"integer","minimum":1},"supersedes_revision_id":{"type":["string","null"]},"reason":{"type":"string"},"revised_at":{"type":"string","format":"date-time"}}},
    "approval":{"type":"object","additionalProperties":false,"required":["approval_id","external_court_decision_reference","amount","currency","decided_on"],"properties":{"approval_id":{"type":"string"},"external_court_decision_reference":{"type":"string","minLength":1},"amount":{"$ref":"#/$defs/amount"},"currency":{"$ref":"#/$defs/currency"},"decided_on":{"type":"string","format":"date"}}},
    "payment":{"type":"object","additionalProperties":false,"required":["payment_id","amount","currency","received_on","reference"],"properties":{"payment_id":{"type":"string"},"amount":{"$ref":"#/$defs/amount"},"currency":{"$ref":"#/$defs/currency"},"received_on":{"type":"string","format":"date"},"reference":{"type":"string"}}}
  }
}
