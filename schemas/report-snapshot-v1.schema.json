{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"report-snapshot-v1.schema.json",
  "title":"Report Snapshot V1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","report_id","workspace_id","source_snapshot","expert_profile","editorial_profile","context_matrix","sections","claims","answers","review_decisions","state","coverage","upstream_stale","upstream_stale_reasons"],
  "properties":{
    "schema_version":{"const":"1.0.0"},"report_id":{"$ref":"#/$defs/text"},"workspace_id":{"$ref":"#/$defs/text"},
    "source_snapshot":{"$ref":"#/$defs/source"},"expert_profile":{"$ref":"#/$defs/expert"},"editorial_profile":{"$ref":"#/$defs/editorial"},
    "context_matrix":{"type":"array","items":{"$ref":"#/$defs/context"}},
    "sections":{"type":"array","minItems":14,"maxItems":14,"items":{"$ref":"#/$defs/section"}},
    "claims":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/claim"}},
    "answers":{"type":"array","items":{"$ref":"#/$defs/answer"}},
    "review_decisions":{"type":"array","items":{"$ref":"#/$defs/review"}},
    "state":{"enum":["DRAFT","REVIEWED","APPROVED","SUPERSEDED"]},"coverage":{"$ref":"#/$defs/coverage"},
    "upstream_stale":{"type":"boolean"},"upstream_stale_reasons":{"$ref":"#/$defs/texts"}
  },
  "$defs":{
    "text":{"type":"string","minLength":1,"pattern":".*\\S.*"},
    "positive":{"type":"integer","minimum":1},
    "nonnegative":{"type":"integer","minimum":0},
    "digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "texts":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/text"}},
    "source":{"type":"object","additionalProperties":false,"required":["workspace_id","case_analysis_snapshot_id","case_analysis_revision","case_analysis_digest","inspection_session_id","inspection_session_revision","inspection_session_digest","technical_snapshot_id","technical_snapshot_revision","technical_snapshot_digest","expert_profile_id","expert_profile_revision","expert_profile_digest"],"properties":{
      "workspace_id":{"$ref":"#/$defs/text"},"case_analysis_snapshot_id":{"$ref":"#/$defs/text"},"case_analysis_revision":{"$ref":"#/$defs/positive"},"case_analysis_digest":{"$ref":"#/$defs/digest"},
      "inspection_session_id":{"$ref":"#/$defs/text"},"inspection_session_revision":{"$ref":"#/$defs/positive"},"inspection_session_digest":{"$ref":"#/$defs/digest"},
      "technical_snapshot_id":{"$ref":"#/$defs/text"},"technical_snapshot_revision":{"$ref":"#/$defs/positive"},"technical_snapshot_digest":{"$ref":"#/$defs/digest"},
      "expert_profile_id":{"$ref":"#/$defs/text"},"expert_profile_revision":{"$ref":"#/$defs/positive"},"expert_profile_digest":{"$ref":"#/$defs/digest"}
    }},
    "expert":{"type":"object","additionalProperties":false,"required":["profile_id","revision","full_name","professional_title","registration","court_registration","contact_line"],"properties":{
      "profile_id":{"$ref":"#/$defs/text"},"revision":{"$ref":"#/$defs/positive"},"full_name":{"$ref":"#/$defs/text"},"professional_title":{"$ref":"#/$defs/text"},"registration":{"$ref":"#/$defs/text"},"court_registration":{"$ref":"#/$defs/text"},"contact_line":{"$ref":"#/$defs/text"}
    }},
    "editorial":{"type":"object","additionalProperties":false,"required":["profile_id","font_family","body_font_pt","table_font_pt","caption_font_pt","alignment","line_spacing","first_line_indent_cm","page_size","margin_top_cm","margin_bottom_cm","margin_left_cm","margin_right_cm","hyphenation","overrides"],"properties":{
      "profile_id":{"const":"JUSTICA_PLURAL_CHAPTER_4"},"font_family":{"const":"Arial"},"body_font_pt":{"const":11},"table_font_pt":{"const":10},"caption_font_pt":{"const":9},"alignment":{"const":"JUSTIFIED"},"line_spacing":{"const":1.15},"first_line_indent_cm":{"const":1.25},"page_size":{"const":"A4"},"margin_top_cm":{"const":2},"margin_bottom_cm":{"const":2},"margin_left_cm":{"const":3},"margin_right_cm":{"const":2},"hyphenation":{"const":false},"overrides":{"$ref":"#/$defs/texts"}
    }},
    "context":{"type":"object","additionalProperties":false,"required":["context_id","field","required","status","source_id","note"],"properties":{"context_id":{"$ref":"#/$defs/text"},"field":{"$ref":"#/$defs/text"},"required":{"type":"boolean"},"status":{"enum":["PRESENT","MISSING","NOT_APPLICABLE"]},"source_id":{"anyOf":[{"$ref":"#/$defs/text"},{"type":"null"}]},"note":{"$ref":"#/$defs/text"}}},
    "section":{"type":"object","additionalProperties":false,"required":["section_id","kind","title","order","required_by_cpc473"],"properties":{
      "section_id":{"$ref":"#/$defs/text"},"kind":{"enum":["IDENTIFICATION","PROCEDURAL_CONTEXT","PURPOSE_OBJECT","SCOPE","DOCUMENTS_EVIDENCE","METHODOLOGY","INSPECTION","TECHNICAL_ANALYSIS","TECHNICAL_FINDINGS","ANSWERS_TO_QUESTIONS","CONCLUSIONS","LIMITATIONS_RESERVATIONS","REFERENCES","ATTACHMENTS"]},"title":{"$ref":"#/$defs/text"},"order":{"$ref":"#/$defs/positive"},"required_by_cpc473":{"type":"boolean"}
    }},
    "provenance":{"type":"object","additionalProperties":false,"required":["provenance_id","source_kind","source_id","source_revision"],"properties":{
      "provenance_id":{"$ref":"#/$defs/text"},"source_kind":{"enum":["ALLEGATION","COURT_DECISION","CASE_DOCUMENT","FIELD_OBSERVATION","MEASUREMENT","TECHNICAL_FINDING","PROFESSIONAL_DECISION"]},"source_id":{"$ref":"#/$defs/text"},"source_revision":{"$ref":"#/$defs/positive"}
    }},
    "claim":{"type":"object","additionalProperties":false,"required":["claim_id","section_id","text","authority","provenance"],"properties":{
      "claim_id":{"$ref":"#/$defs/text"},"section_id":{"$ref":"#/$defs/text"},"text":{"$ref":"#/$defs/text"},"authority":{"enum":["ALLEGED","DECIDED_BY_COURT","DOCUMENTED","OBSERVED","MEASURED","TECHNICALLY_FOUND","PROFESSIONALLY_CONCLUDED"]},"provenance":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/provenance"}}
    }},
    "answer":{"type":"object","additionalProperties":false,"required":["answer_id","section_id","question_id","text","finding_id","evidence_ids","method_ids","decision_id","claim_ids"],"properties":{
      "answer_id":{"$ref":"#/$defs/text"},"section_id":{"$ref":"#/$defs/text"},"question_id":{"$ref":"#/$defs/text"},"text":{"$ref":"#/$defs/text"},"finding_id":{"$ref":"#/$defs/text"},"evidence_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/text"}},"method_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/text"}},"decision_id":{"$ref":"#/$defs/text"},"claim_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/text"}}
    }},
    "review":{"type":"object","additionalProperties":false,"required":["review_id","action","professional_id","reason","timestamp","supersedes_review_id"],"properties":{
      "review_id":{"$ref":"#/$defs/text"},"action":{"enum":["MARK_REVIEWED","APPROVE","SUPERSEDE"]},"professional_id":{"$ref":"#/$defs/text"},"reason":{"$ref":"#/$defs/text"},"timestamp":{"type":"string","format":"date-time"},"supersedes_review_id":{"anyOf":[{"$ref":"#/$defs/text"},{"type":"null"}]}
    }},
    "coverage":{"type":"object","additionalProperties":false,"required":["sections","material_claims","traceable_claims","answers","traceable_answers","cpc473_required_sections","cpc473_present_sections","context_required_fields","context_present_fields","complete","reasons"],"properties":{
      "sections":{"$ref":"#/$defs/nonnegative"},"material_claims":{"$ref":"#/$defs/nonnegative"},"traceable_claims":{"$ref":"#/$defs/nonnegative"},"answers":{"$ref":"#/$defs/nonnegative"},"traceable_answers":{"$ref":"#/$defs/nonnegative"},"cpc473_required_sections":{"$ref":"#/$defs/nonnegative"},"cpc473_present_sections":{"$ref":"#/$defs/nonnegative"},"context_required_fields":{"$ref":"#/$defs/nonnegative"},"context_present_fields":{"$ref":"#/$defs/nonnegative"},"complete":{"type":"boolean"},"reasons":{"$ref":"#/$defs/texts"}
    }}
  }
}
