{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://padrao-laudos.local/schemas/workspace-backup-v1.schema.json",
  "title": "Workspace Backup V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "format_version", "product_release", "storage_schema_version", "workspace", "artifact_revisions", "private_contents", "member_hashes", "manifest_sha256", "created_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "format_version": {"const": 1},
    "product_release": {"type": "string", "minLength": 1},
    "storage_schema_version": {"type": "integer", "minimum": 1},
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace_id", "name", "created_at"],
      "properties": {
        "workspace_id": {"type": "string", "format": "uuid"},
        "name": {"type": "string", "minLength": 1},
        "created_at": {"type": "string", "format": "date-time"}
      }
    },
    "artifact_revisions": {"type": "array", "items": {"type": "object"}},
    "private_contents": {"type": "array", "items": {"type": "object"}},
    "member_hashes": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
