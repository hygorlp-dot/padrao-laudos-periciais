{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://padrao-laudos-periciais.local/schemas/delimitacao-pericial.schema.json",
  "title": "Delimitação técnica do encargo pericial",
  "type": "object",
  "required": ["schema_version", "identificacao", "tipo_pericia", "subtipos_pericia", "assunto_processual", "controversia_processual", "tema_controvertido", "objeto_material", "objetivo_pericial", "questoes_tecnicas", "quesitos", "matriz_cobertura", "ressalvas", "fatores_limitantes", "conflitos", "materias_excluidas", "documentos_relevantes", "documentos_ausentes", "metodologia_preliminar", "modulos_tecnicos", "plano_pericial_preliminar", "memoria_referencial", "conhecimento_normativo", "autoauditoria", "status", "proveniencia"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "minLength": 1},
    "identificacao": {"$ref": "#/$defs/identificacao"},
    "tipo_pericia": {"$ref": "#/$defs/tipoPericia"},
    "subtipos_pericia": {"type": "array", "items": {"$ref": "#/$defs/tipoPericiaValor"}, "uniqueItems": true},
    "assunto_processual": {"$ref": "#/$defs/analise"},
    "controversia_processual": {"$ref": "#/$defs/analise"},
    "tema_controvertido": {"$ref": "#/$defs/analise"},
    "objeto_material": {"$ref": "#/$defs/analise"},
    "objetivo_pericial": {"$ref": "#/$defs/analise"},
    "questoes_tecnicas": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/questaoTecnica"}},
    "quesitos": {"type": "array", "items": {"$ref": "#/$defs/quesitoDelimitado"}},
    "matriz_cobertura": {"type": "array", "items": {"$ref": "#/$defs/cobertura"}},
    "ressalvas": {"type": "array", "items": {"$ref": "#/$defs/ressalva"}},
    "fatores_limitantes": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "conflitos": {"type": "array", "items": {"$ref": "#/$defs/conflito"}},
    "materias_excluidas": {"type": "array", "items": {"$ref": "#/$defs/materiaExcluida"}},
    "documentos_relevantes": {"type": "array", "items": {"$ref": "#/$defs/documentoRelacionado"}},
    "documentos_ausentes": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "metodologia_preliminar": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "modulos_tecnicos": {"type": "array", "items": {"$ref": "#/$defs/modulo"}},
    "plano_pericial_preliminar": {"$ref": "#/$defs/plano"},
    "memoria_referencial": {"$ref": "#/$defs/recuperacaoConhecimento"},
    "conhecimento_normativo": {"$ref": "#/$defs/recuperacaoConhecimento"},
    "autoauditoria": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/itemAuditoria"}},
    "status": {"enum": ["APTO_PARA_PLANEJAMENTO", "BLOQUEADO", "PENDENTE_EVIDENCIAS_ADICIONAIS"]},
    "proveniencia": {"type": "array", "minItems": 1, "items": {"$ref": "pje-comum.schema.json#/$defs/proveniencia"}}
  },
  "$defs": {
    "confianca": {"$ref": "pje-comum.schema.json#/$defs/confianca"},
    "tipoPericiaValor": {"enum": ["VICIOS_CONSTRUTIVOS", "AVALIACAO_IMOBILIARIA", "ENGENHARIA_RODOVIARIA", "SINISTRO_VIARIO", "ORCAMENTO_E_MEDICAO", "ESTRUTURAS", "TOPOGRAFIA_E_DIVISAS", "INSTALACOES_PREDIAIS", "SEGURANCA_VIARIA", "OUTRO"]},
    "identificacao": {"type": "object", "required": ["processo_cnj", "manifesto_sha256", "data_geracao"], "additionalProperties": false, "properties": {"processo_cnj": {"$ref": "pje-comum.schema.json#/$defs/numeroCnj"}, "manifesto_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}, "data_geracao": {"type": "string", "format": "date-time"}}},
    "tipoPericia": {"type": "object", "required": ["tipo", "confianca", "evidencias", "documentos_fonte", "criterios", "alternativas_consideradas"], "additionalProperties": false, "properties": {"tipo": {"$ref": "#/$defs/tipoPericiaValor"}, "confianca": {"$ref": "#/$defs/confianca"}, "evidencias": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "documentos_fonte": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^DOC-PJE-[0-9]{3,}$"}}, "criterios": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "alternativas_consideradas": {"type": "array", "items": {"$ref": "#/$defs/tipoPericiaValor"}, "uniqueItems": true}}},
    "analise": {"type": "object", "required": ["texto", "confianca", "documentos_fonte", "status_verificacao"], "additionalProperties": false, "properties": {"texto": {"type": "string", "minLength": 1}, "confianca": {"$ref": "#/$defs/confianca"}, "documentos_fonte": {"type": "array", "items": {"type": "string", "pattern": "^DOC-PJE-[0-9]{3,}$"}}, "status_verificacao": {"enum": ["VERIFICADO", "INCONCLUSIVO", "PENDENTE_VALIDACAO_PERITO"]}}},
    "questaoTecnica": {"type": "object", "required": ["id", "descricao", "origem", "necessidade_para_saneamento", "quesitos_relacionados", "alegacoes_relacionadas", "evidencias_disponiveis", "evidencias_necessarias", "documentos_relacionados", "ressalvas", "status_saneamento", "confianca", "proveniencia"], "additionalProperties": false, "properties": {"id": {"type": "string", "pattern": "^QT-[0-9]{3,}$"}, "descricao": {"type": "string", "minLength": 1}, "origem": {"type": "string", "minLength": 1}, "necessidade_para_saneamento": {"type": "string", "minLength": 1}, "quesitos_relacionados": {"type": "array", "items": {"type": "string", "pattern": "^QUE-[0-9]{3,}$"}}, "alegacoes_relacionadas": {"type": "array", "items": {"type": "string", "pattern": "^ALG-[0-9]{3,}$"}}, "evidencias_disponiveis": {"type": "array", "items": {"type": "string", "minLength": 1}}, "evidencias_necessarias": {"type": "array", "items": {"type": "string", "minLength": 1}}, "documentos_relacionados": {"type": "array", "items": {"type": "string", "pattern": "^DOC-PJE-[0-9]{3,}$"}}, "ressalvas": {"type": "array", "items": {"type": "string", "pattern": "^RES-[0-9]{3,}$"}}, "status_saneamento": {"enum": ["A_SANEAR", "PARCIALMENTE_SANEADA", "SANEADA", "SANEADA_COM_RESSALVA", "INCONCLUSIVA_POR_LIMITACAO", "PREJUDICADA", "FORA_DO_ESCOPO_TECNICO"]}, "confianca": {"$ref": "#/$defs/confianca"}, "proveniencia": {"type": "array", "minItems": 1, "items": {"$ref": "pje-comum.schema.json#/$defs/proveniencia"}}}},
    "quesitoDelimitado": {"type": "object", "required": ["id", "origem", "documento_id", "id_pje", "numero_original", "caminho_original", "ordem_real", "texto_integral", "subitens", "paginas", "pertinencia", "questoes_tecnicas_relacionadas", "evidencias_necessarias", "ressalvas_aplicaveis", "status_cobertura", "materia_tecnica", "materia_juridica_associada", "secoes_laudisticas_previstas", "proveniencia"], "additionalProperties": false, "properties": {"id": {"type": "string", "pattern": "^QUE-[0-9]{3,}$"}, "origem": {"enum": ["JUIZO", "AUTOR", "REU", "TERCEIRO", "INDETERMINADA"]}, "documento_id": {"type": "string", "pattern": "^DOC-PJE-[0-9]{3,}$"}, "id_pje": {"$ref": "pje-comum.schema.json#/$defs/idPje"}, "numero_original": {"type": ["string", "null"]}, "caminho_original": {"type": ["string", "null"]}, "ordem_real": {"type": "integer", "minimum": 1}, "texto_integral": {"type": "string", "minLength": 1}, "subitens": {"type": "array", "items": {"type": "string"}}, "paginas": {"type": "array", "minItems": 1, "items": {"$ref": "pje-comum.schema.json#/$defs/referenciaPagina"}}, "pertinencia": {"enum": ["PERTINENTE_TECNICO", "PERTINENTE_PARCIAL", "REPETITIVO", "PREJUDICADO_POR_LIMITACAO", "FORA_DA_ESPECIALIDADE", "MATERIA_JURIDICA", "INDETERMINADO"]}, "questoes_tecnicas_relacionadas": {"type": "array", "items": {"type": "string", "pattern": "^QT-[0-9]{3,}$"}}, "evidencias_necessarias": {"type": "array", "items": {"type": "string"}}, "ressalvas_aplicaveis": {"type": "array", "items": {"type": "string", "pattern": "^RES-[0-9]{3,}$"}}, "status_cobertura": {"enum": ["COBERTO", "PARCIAL", "REPETITIVO", "PREJUDICADO", "JURIDICO_DELIMITADO", "SEM_TRATAMENTO"]}, "materia_tecnica": {"type": ["string", "null"]}, "materia_juridica_associada": {"type": ["string", "null"]}, "secoes_laudisticas_previstas": {"type": "array", "items": {"type": "string"}}, "proveniencia": {"type": "array", "minItems": 1, "items": {"$ref": "pje-comum.schema.json#/$defs/proveniencia"}}}},
    "cobertura": {"type": "object", "required": ["quesito_id", "questoes_tecnicas", "secoes_laudisticas", "status"], "additionalProperties": false, "properties": {"quesito_id": {"type": "string", "pattern": "^QUE-[0-9]{3,}$"}, "questoes_tecnicas": {"type": "array", "items": {"type": "string", "pattern": "^QT-[0-9]{3,}$"}}, "secoes_laudisticas": {"type": "array", "items": {"type": "string"}}, "status": {"enum": ["COBERTO", "PARCIAL", "REPETITIVO", "PREJUDICADO", "JURIDICO_DELIMITADO", "SEM_TRATAMENTO"]}}},
    "ressalva": {"type": "object", "required": ["id", "categoria", "descricao", "causa", "evidencia", "questoes_afetadas", "quesitos_afetados", "conclusoes_impedidas", "conclusoes_ainda_permitidas", "efeito_no_grau_de_certeza", "proveniencia"], "additionalProperties": false, "properties": {"id": {"type": "string", "pattern": "^RES-[0-9]{3,}$"}, "categoria": {"enum": ["LIMITACAO_DOCUMENTAL", "LIMITACAO_TEMPORAL", "LIMITACAO_DE_VISTORIA", "LIMITACAO_METODOLOGICA", "LIMITACAO_AMOSTRAL", "LIMITACAO_INSTRUMENTAL", "LIMITACAO_DE_ACESSO", "LIMITACAO_DE_REPRODUCAO", "INCERTEZA_TECNICA", "PRESSUPOSTO_ADOTADO", "ESCOPO_DE_COMPETENCIA", "MATERIA_JURIDICA_EXCLUIDA", "DADO_NAO_DISPONIVEL", "DADO_NAO_VERIFICAVEL", "OUTRA"]}, "descricao": {"type": "string"}, "causa": {"type": "string"}, "evidencia": {"type": "string"}, "questoes_afetadas": {"type": "array", "items": {"type": "string", "pattern": "^QT-[0-9]{3,}$"}}, "quesitos_afetados": {"type": "array", "items": {"type": "string", "pattern": "^QUE-[0-9]{3,}$"}}, "conclusoes_impedidas": {"type": "array", "items": {"type": "string"}}, "conclusoes_ainda_permitidas": {"type": "array", "items": {"type": "string"}}, "efeito_no_grau_de_certeza": {"type": "string"}, "proveniencia": {"type": "array", "minItems": 1, "items": {"$ref": "pje-comum.schema.json#/$defs/proveniencia"}}}},
    "conflito": {"type": "object", "required": ["id", "tipo", "descricao", "fontes", "classificacao", "resolucao", "status"], "additionalProperties": false, "properties": {"id": {"type": "string", "pattern": "^CNF-[0-9]{3,}$"}, "tipo": {"type": "string"}, "descricao": {"type": "string"}, "fontes": {"type": "array", "minItems": 2, "items": {"$ref": "pje-comum.schema.json#/$defs/proveniencia"}}, "classificacao": {"enum": ["INFORMATIVO", "RELEVANTE", "BLOQUEANTE"]}, "resolucao": {"type": ["string", "null"]}, "status": {"enum": ["ABERTO", "RESOLVIDO_POR_HIERARQUIA_DE_FONTES", "PENDENTE_VALIDACAO_PERITO"]}}},
    "materiaExcluida": {"type": "object", "required": ["descricao", "motivo", "tratamento_tecnico"], "additionalProperties": false, "properties": {"descricao": {"type": "string"}, "motivo": {"enum": ["MATERIA_JURIDICA", "FORA_DA_ESPECIALIDADE", "FORA_DO_ENCARGO"]}, "tratamento_tecnico": {"type": "string"}}},
    "documentoRelacionado": {"type": "object", "required": ["documento_id", "papel", "autoridade", "justificativa"], "additionalProperties": false, "properties": {"documento_id": {"type": "string", "pattern": "^DOC-PJE-[0-9]{3,}$"}, "papel": {"type": "string"}, "autoridade": {"enum": ["DELIMITACAO_PRIMARIA", "PROVA_DOCUMENTAL", "ALEGACAO", "EXPERIENCIA_REFERENCIAL"]}, "justificativa": {"type": "string"}}},
    "modulo": {"type": "object", "required": ["nome", "prioridade", "sistemas"], "additionalProperties": false, "properties": {"nome": {"$ref": "#/$defs/tipoPericiaValor"}, "prioridade": {"enum": ["PRINCIPAL", "COMPLEMENTAR"]}, "sistemas": {"type": "array", "items": {"enum": ["REVESTIMENTOS", "VEDACOES", "ESTRUTURA", "IMPERMEABILIZACAO", "COBERTURA", "FORROS", "ESQUADRIAS", "INSTALACOES_ELETRICAS", "INSTALACOES_HIDROSSANITARIAS", "DRENAGEM", "PINTURA", "OUTRO"]}}}},
    "plano": {"type": "object", "required": ["o_que_verificar", "o_que_fotografar", "o_que_medir", "ensaios_sugeridos", "equipamentos_sugeridos", "documentos_a_solicitar", "pontos_criticos", "questoes_que_dependem_da_vistoria"], "additionalProperties": false, "properties": {"o_que_verificar": {"type": "array", "items": {"type": "string"}}, "o_que_fotografar": {"type": "array", "items": {"type": "string"}}, "o_que_medir": {"type": "array", "items": {"type": "string"}}, "ensaios_sugeridos": {"type": "array", "items": {"type": "string"}}, "equipamentos_sugeridos": {"type": "array", "items": {"type": "string"}}, "documentos_a_solicitar": {"type": "array", "items": {"type": "string"}}, "pontos_criticos": {"type": "array", "items": {"type": "string"}}, "questoes_que_dependem_da_vistoria": {"type": "array", "items": {"type": "string", "pattern": "^QT-[0-9]{3,}$"}}}},
    "recuperacaoConhecimento": {"type": "object", "required": ["fontes_disponiveis", "itens_recuperados", "status"], "additionalProperties": false, "properties": {"fontes_disponiveis": {"type": "integer", "minimum": 0}, "itens_recuperados": {"type": "array", "items": {"type": "string"}}, "fontes": {"type": "array", "items": {"type": "object", "required": ["id", "proveniencia"], "additionalProperties": false, "properties": {"id": {"type": "string"}, "proveniencia": {"type": "array", "minItems": 1, "items": {"type": "string"}}}}}, "status": {"enum": ["DISPONIVEL", "INDISPONIVEL", "PENDENTE_VERIFICACAO_NORMATIVA"]}}},
    "itemAuditoria": {"type": "object", "required": ["criterio", "resultado", "observacao"], "additionalProperties": false, "properties": {"criterio": {"type": "string"}, "resultado": {"enum": ["APROVADO", "ALERTA", "BLOQUEADO"]}, "observacao": {"type": "string"}}}
  }
}
