{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://padrao-laudos-periciais.local/schemas/case-analysis-snapshot-v1.schema.json",
  "title": "Case Analysis Snapshot V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "workspace_id",
    "source_revision",
    "participant_refs",
    "judicial_context",
    "documents",
    "claims",
    "counterarguments",
    "decisions",
    "pericial_objects",
    "questions",
    "events",
    "technical_document_references",
    "gaps",
    "conflicts",
    "coverage",
    "human_reviews",
    "stale_document_ids"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "snapshot_id": { "$ref": "#/$defs/text" },
    "workspace_id": { "type": "string", "format": "uuid" },
    "source_revision": { "type": "integer", "minimum": 1 },
    "participant_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/text" }
    },
    "judicial_context": { "type": "object" },
    "documents": { "type": "array", "items": { "type": "object" } },
    "claims": { "$ref": "#/$defs/items" },
    "counterarguments": { "$ref": "#/$defs/items" },
    "decisions": { "$ref": "#/$defs/items" },
    "pericial_objects": { "$ref": "#/$defs/items" },
    "questions": { "$ref": "#/$defs/items" },
    "events": { "$ref": "#/$defs/items" },
    "technical_document_references": { "$ref": "#/$defs/items" },
    "gaps": { "$ref": "#/$defs/items" },
    "conflicts": { "$ref": "#/$defs/items" },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "documents_total",
        "documents_analyzed",
        "documents_unavailable",
        "documents_failed",
        "source_revision"
      ],
      "properties": {
        "status": { "enum": ["COMPLETE", "PARTIAL", "UNAVAILABLE"] },
        "documents_total": { "type": "integer", "minimum": 0 },
        "documents_analyzed": { "type": "integer", "minimum": 0 },
        "documents_unavailable": { "type": "integer", "minimum": 0 },
        "documents_failed": { "type": "integer", "minimum": 0 },
        "source_revision": { "type": "integer", "minimum": 1 }
      }
    },
    "human_reviews": { "type": "array", "items": { "type": "object" } },
    "stale_document_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/text" }
    }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "sha": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspace_id",
        "source_document_id",
        "source_document_sha256",
        "page_or_span",
        "source_revision",
        "occurrence_id"
      ],
      "properties": {
        "workspace_id": { "type": "string", "format": "uuid" },
        "source_document_id": { "$ref": "#/$defs/text" },
        "source_document_sha256": { "$ref": "#/$defs/sha" },
        "page_or_span": { "$ref": "#/$defs/text" },
        "source_revision": { "type": "integer", "minimum": 1 },
        "occurrence_id": { "$ref": "#/$defs/text" }
      }
    },
    "item": {
      "type": "object",
      "required": [
        "item_id",
        "text",
        "participant_refs",
        "technical_subjects",
        "provenance"
      ],
      "properties": {
        "item_id": { "$ref": "#/$defs/text" },
        "text": { "$ref": "#/$defs/text" },
        "participant_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/text" }
        },
        "technical_subjects": {
          "type": "array",
          "items": { "$ref": "#/$defs/text" }
        },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/provenance" }
        }
      }
    },
    "items": { "type": "array", "items": { "$ref": "#/$defs/item" } }
  }
}
