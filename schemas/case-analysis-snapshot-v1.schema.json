{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://padrao-laudos-periciais.local/schemas/case-analysis-snapshot-v1.schema.json",
  "title": "Case Analysis Snapshot V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "workspace_id",
    "source_revision",
    "participant_refs",
    "judicial_context_workspace_id",
    "judicial_context",
    "documents",
    "claims",
    "counterarguments",
    "decisions",
    "pericial_objects",
    "questions",
    "events",
    "technical_document_references",
    "gaps",
    "conflicts",
    "coverage",
    "human_reviews",
    "stale_document_ids",
    "source_inventory_stale",
    "unindexed_source_count"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "snapshot_id": { "$ref": "#/$defs/text" },
    "workspace_id": { "type": "string", "format": "uuid" },
    "source_revision": { "type": "integer", "minimum": 1 },
    "participant_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/text" }
    },
    "judicial_context_workspace_id": { "type": "string", "format": "uuid" },
    "judicial_context": {
      "$ref": "https://padrao-laudos-periciais.local/schemas/judicial-domain-model-v1.schema.json"
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "document_id",
          "storage_content_id",
          "source_sha256",
          "sequence",
          "document_role",
          "raw_type",
          "normalized_type",
          "timestamp",
          "participant_refs",
          "page_count_or_span",
          "content_available",
          "analysis_revision"
        ],
        "properties": {
          "document_id": { "$ref": "#/$defs/text" },
          "storage_content_id": { "type": "string", "format": "uuid" },
          "source_sha256": { "$ref": "#/$defs/sha" },
          "sequence": { "type": "integer", "minimum": 1 },
          "document_role": { "$ref": "#/$defs/text" },
          "raw_type": { "$ref": "#/$defs/text" },
          "normalized_type": { "$ref": "#/$defs/text" },
          "timestamp": { "type": ["string", "null"] },
          "participant_refs": {
            "type": "array",
            "items": { "$ref": "#/$defs/text" }
          },
          "page_count_or_span": { "$ref": "#/$defs/text" },
          "content_available": { "type": "boolean" },
          "analysis_revision": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "claims": { "$ref": "#/$defs/baseItems" },
    "counterarguments": { "$ref": "#/$defs/counterargumentItems" },
    "decisions": { "$ref": "#/$defs/decisionItems" },
    "pericial_objects": { "$ref": "#/$defs/baseItems" },
    "questions": { "$ref": "#/$defs/questionItems" },
    "events": { "$ref": "#/$defs/eventItems" },
    "technical_document_references": {
      "$ref": "#/$defs/technicalReferenceItems"
    },
    "gaps": { "$ref": "#/$defs/baseItems" },
    "conflicts": { "$ref": "#/$defs/conflictItems" },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "documents_total",
        "documents_analyzed",
        "documents_unavailable",
        "documents_failed",
        "source_revision"
      ],
      "properties": {
        "status": { "enum": ["COMPLETE", "PARTIAL", "UNAVAILABLE"] },
        "documents_total": { "type": "integer", "minimum": 0 },
        "documents_analyzed": { "type": "integer", "minimum": 0 },
        "documents_unavailable": { "type": "integer", "minimum": 0 },
        "documents_failed": { "type": "integer", "minimum": 0 },
        "source_revision": { "type": "integer", "minimum": 1 }
      }
    },
    "human_reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "review_id",
          "target_item_id",
          "original_extraction",
          "decision",
          "corrected_value",
          "reviewer",
          "revision",
          "timestamp",
          "reason"
        ],
        "properties": {
          "review_id": { "$ref": "#/$defs/text" },
          "target_item_id": { "$ref": "#/$defs/text" },
          "original_extraction": { "$ref": "#/$defs/text" },
          "decision": { "$ref": "#/$defs/text" },
          "corrected_value": { "$ref": "#/$defs/text" },
          "reviewer": { "$ref": "#/$defs/text" },
          "revision": { "type": "integer", "minimum": 1 },
          "timestamp": { "$ref": "#/$defs/text" },
          "reason": { "$ref": "#/$defs/text" }
        },
        "additionalProperties": false
      }
    },
    "stale_document_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/text" }
    },
    "source_inventory_stale": { "type": "boolean" },
    "unindexed_source_count": { "type": "integer", "minimum": 0 }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "sha": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspace_id",
        "source_document_id",
        "source_document_sha256",
        "page_or_span",
        "source_revision",
        "occurrence_id"
      ],
      "properties": {
        "workspace_id": { "type": "string", "format": "uuid" },
        "source_document_id": { "$ref": "#/$defs/text" },
        "source_document_sha256": { "$ref": "#/$defs/sha" },
        "page_or_span": { "$ref": "#/$defs/text" },
        "source_revision": { "type": "integer", "minimum": 1 },
        "occurrence_id": { "$ref": "#/$defs/text" }
      }
    },
    "item": {
      "type": "object",
      "required": [
        "item_id",
        "text",
        "participant_refs",
        "technical_subjects",
        "provenance"
      ],
      "properties": {
        "item_id": { "$ref": "#/$defs/text" },
        "text": { "$ref": "#/$defs/text" },
        "participant_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/text" }
        },
        "technical_subjects": {
          "type": "array",
          "items": { "$ref": "#/$defs/text" }
        },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/provenance" }
        },
        "target_claim_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/text" }
        },
        "addressed_claim_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/text" }
        },
        "addressed_counterargument_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/text" }
        },
        "answer": { "type": "null" },
        "event_raw": { "$ref": "#/$defs/text" },
        "event_normalized": { "$ref": "#/$defs/text" },
        "timestamp": { "type": ["string", "null"] },
        "normalization_authority": { "$ref": "#/$defs/text" },
        "external_reference": { "type": "boolean" },
        "statement_a_id": { "$ref": "#/$defs/text" },
        "statement_b_id": { "$ref": "#/$defs/text" },
        "conflict_dimension": { "$ref": "#/$defs/text" },
        "analysis_status": {
          "enum": ["PROPOSED_CONFLICT", "HUMAN_CONFIRMED", "HUMAN_REJECTED"]
        },
        "human_review_status": { "$ref": "#/$defs/text" }
      },
      "additionalProperties": false
    },
    "baseItems": {
      "type": "array",
      "items": {
        "allOf": [{ "$ref": "#/$defs/item" }],
        "not": {
          "anyOf": [
            { "required": ["target_claim_ids"] },
            { "required": ["addressed_claim_ids"] },
            { "required": ["addressed_counterargument_ids"] },
            { "required": ["answer"] },
            { "required": ["event_raw"] },
            { "required": ["event_normalized"] },
            { "required": ["timestamp"] },
            { "required": ["normalization_authority"] },
            { "required": ["external_reference"] },
            { "required": ["statement_a_id"] },
            { "required": ["statement_b_id"] },
            { "required": ["conflict_dimension"] },
            { "required": ["analysis_status"] },
            { "required": ["human_review_status"] }
          ]
        }
      }
    },
    "counterargumentItems": {
      "type": "array",
      "items": {
        "allOf": [
          { "$ref": "#/$defs/item" },
          { "required": ["target_claim_ids"] }
        ],
        "not": { "anyOf": [
          { "required": ["addressed_claim_ids"] }, { "required": ["addressed_counterargument_ids"] },
          { "required": ["answer"] }, { "required": ["event_raw"] }, { "required": ["event_normalized"] },
          { "required": ["timestamp"] }, { "required": ["normalization_authority"] },
          { "required": ["external_reference"] }, { "required": ["statement_a_id"] },
          { "required": ["statement_b_id"] }, { "required": ["conflict_dimension"] },
          { "required": ["analysis_status"] }, { "required": ["human_review_status"] }
        ] }
      }
    },
    "decisionItems": {
      "type": "array",
      "items": {
        "allOf": [
          { "$ref": "#/$defs/item" },
          {
            "required": ["addressed_claim_ids", "addressed_counterargument_ids"]
          }
        ],
        "not": { "anyOf": [
          { "required": ["target_claim_ids"] }, { "required": ["answer"] },
          { "required": ["event_raw"] }, { "required": ["event_normalized"] }, { "required": ["timestamp"] },
          { "required": ["normalization_authority"] }, { "required": ["external_reference"] },
          { "required": ["statement_a_id"] }, { "required": ["statement_b_id"] },
          { "required": ["conflict_dimension"] }, { "required": ["analysis_status"] },
          { "required": ["human_review_status"] }
        ] }
      }
    },
    "questionItems": {
      "type": "array",
      "items": {
        "allOf": [{ "$ref": "#/$defs/item" }, { "required": ["answer"] }],
        "not": { "anyOf": [
          { "required": ["target_claim_ids"] }, { "required": ["addressed_claim_ids"] },
          { "required": ["addressed_counterargument_ids"] }, { "required": ["event_raw"] },
          { "required": ["event_normalized"] }, { "required": ["timestamp"] },
          { "required": ["normalization_authority"] }, { "required": ["external_reference"] },
          { "required": ["statement_a_id"] }, { "required": ["statement_b_id"] },
          { "required": ["conflict_dimension"] }, { "required": ["analysis_status"] },
          { "required": ["human_review_status"] }
        ] }
      }
    },
    "eventItems": {
      "type": "array",
      "items": {
        "allOf": [
          { "$ref": "#/$defs/item" },
          {
            "required": [
              "event_raw",
              "event_normalized",
              "timestamp",
              "normalization_authority"
            ]
          }
        ],
        "not": { "anyOf": [
          { "required": ["target_claim_ids"] }, { "required": ["addressed_claim_ids"] },
          { "required": ["addressed_counterargument_ids"] }, { "required": ["answer"] },
          { "required": ["external_reference"] }, { "required": ["statement_a_id"] },
          { "required": ["statement_b_id"] }, { "required": ["conflict_dimension"] },
          { "required": ["analysis_status"] }, { "required": ["human_review_status"] }
        ] }
      }
    },
    "technicalReferenceItems": {
      "type": "array",
      "items": {
        "allOf": [
          { "$ref": "#/$defs/item" },
          { "required": ["external_reference"] }
        ],
        "not": { "anyOf": [
          { "required": ["target_claim_ids"] }, { "required": ["addressed_claim_ids"] },
          { "required": ["addressed_counterargument_ids"] }, { "required": ["answer"] },
          { "required": ["event_raw"] }, { "required": ["event_normalized"] },
          { "required": ["timestamp"] }, { "required": ["normalization_authority"] },
          { "required": ["statement_a_id"] }, { "required": ["statement_b_id"] },
          { "required": ["conflict_dimension"] }, { "required": ["analysis_status"] },
          { "required": ["human_review_status"] }
        ] }
      }
    },
    "conflictItems": {
      "type": "array",
      "items": {
        "allOf": [
          { "$ref": "#/$defs/item" },
          {
            "required": [
              "statement_a_id",
              "statement_b_id",
              "conflict_dimension",
              "analysis_status",
              "human_review_status"
            ]
          }
        ],
        "not": { "anyOf": [
          { "required": ["target_claim_ids"] }, { "required": ["addressed_claim_ids"] },
          { "required": ["addressed_counterargument_ids"] }, { "required": ["answer"] },
          { "required": ["event_raw"] }, { "required": ["event_normalized"] },
          { "required": ["timestamp"] }, { "required": ["normalization_authority"] },
          { "required": ["external_reference"] }
        ] }
      }
    }
  }
}
