{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://padrao-laudos-periciais.local/schemas/report-template-manifest-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "template_id", "output_kind", "bindings"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "template_id": {"type": "string", "minLength": 1},
    "output_kind": {"enum": ["DOCX", "DOCM"]},
    "bindings": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["field", "placeholder"],
        "properties": {"field": {"enum": ["EXPERT_FULL_NAME", "EXPERT_REGISTRATION", "REPORT_ID"]}, "placeholder": {"type": "string", "minLength": 1}}
      }
    }
  }
}
