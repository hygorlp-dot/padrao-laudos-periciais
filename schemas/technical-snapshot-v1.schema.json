{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"technical-snapshot-v1.schema.json",
  "title":"Technical Snapshot V1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","snapshot_id","workspace_id","source_snapshot","evidence_items","source_links","evidence_assessments","method_applications","method_inputs","method_outputs","finding_proposals","findings","dependencies","conflicts","limitations","uncertainties","question_links","decisions","coverage","upstream_stale","upstream_stale_reasons"],
  "properties":{
    "schema_version":{"const":"1.0.0"},"snapshot_id":{"$ref":"#/$defs/text"},"workspace_id":{"type":"string","format":"uuid"},
    "source_snapshot":{"$ref":"#/$defs/sourceSnapshot"},
    "evidence_items":{"type":"array","items":{"$ref":"#/$defs/evidenceItem"}},
    "source_links":{"type":"array","items":{"$ref":"#/$defs/sourceLink"}},
    "evidence_assessments":{"type":"array","items":{"$ref":"#/$defs/evidenceAssessment"}},
    "method_applications":{"type":"array","items":{"$ref":"#/$defs/methodApplication"}},
    "method_inputs":{"type":"array","items":{"$ref":"#/$defs/methodInput"}},
    "method_outputs":{"type":"array","items":{"$ref":"#/$defs/methodOutput"}},
    "finding_proposals":{"type":"array","items":{"$ref":"#/$defs/proposal"}},
    "findings":{"type":"array","items":{"$ref":"#/$defs/finding"}},
    "dependencies":{"type":"array","items":{"$ref":"#/$defs/dependency"}},
    "conflicts":{"type":"array","items":{"$ref":"#/$defs/conflict"}},
    "limitations":{"type":"array","items":{"$ref":"#/$defs/limitation"}},
    "uncertainties":{"type":"array","items":{"$ref":"#/$defs/uncertainty"}},
    "question_links":{"type":"array","items":{"$ref":"#/$defs/questionLink"}},
    "decisions":{"type":"array","items":{"$ref":"#/$defs/decision"}},
    "coverage":{"$ref":"#/$defs/coverage"},"upstream_stale":{"type":"boolean"},"upstream_stale_reasons":{"$ref":"#/$defs/texts"}
  },
  "$defs":{
    "text":{"type":"string","minLength":1,"pattern":".*\\S.*"},"nullableText":{"anyOf":[{"$ref":"#/$defs/text"},{"type":"null"}]},"texts":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/text"}},"ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/text"}},"revision":{"type":"integer","minimum":1},"sha":{"type":"string","pattern":"^[0-9a-f]{64}$"},"timestamp":{"type":"string","format":"date-time"},
    "sourceSnapshot":{"type":"object","additionalProperties":false,"required":["workspace_id","case_analysis_snapshot_id","case_analysis_revision","case_analysis_digest","inspection_session_id","inspection_session_revision","inspection_session_digest","source_revision"],"properties":{"workspace_id":{"type":"string","format":"uuid"},"case_analysis_snapshot_id":{"$ref":"#/$defs/text"},"case_analysis_revision":{"$ref":"#/$defs/revision"},"case_analysis_digest":{"$ref":"#/$defs/sha"},"inspection_session_id":{"$ref":"#/$defs/text"},"inspection_session_revision":{"$ref":"#/$defs/revision"},"inspection_session_digest":{"$ref":"#/$defs/sha"},"source_revision":{"$ref":"#/$defs/revision"}}},
    "evidenceItem":{"type":"object","additionalProperties":false,"required":["evidence_id","proposition","assessment_id"],"properties":{"evidence_id":{"$ref":"#/$defs/text"},"proposition":{"$ref":"#/$defs/text"},"assessment_id":{"$ref":"#/$defs/text"}}},
    "sourceLink":{"type":"object","additionalProperties":false,"required":["link_id","evidence_id","source_kind","source_id","source_revision","provenance"],"properties":{"link_id":{"$ref":"#/$defs/text"},"evidence_id":{"$ref":"#/$defs/text"},"source_kind":{"$ref":"#/$defs/text"},"source_id":{"$ref":"#/$defs/text"},"source_revision":{"$ref":"#/$defs/revision"},"provenance":{"$ref":"#/$defs/text"}}},
    "evidenceAssessment":{"type":"object","additionalProperties":false,"required":["assessment_id","evidence_id","why_relevant","supported_proposition","limitation_ids","contrary_evidence_ids","source_link_ids","review_state","reviewer","reviewed_at"],"properties":{"assessment_id":{"$ref":"#/$defs/text"},"evidence_id":{"$ref":"#/$defs/text"},"why_relevant":{"$ref":"#/$defs/text"},"supported_proposition":{"$ref":"#/$defs/text"},"limitation_ids":{"$ref":"#/$defs/texts"},"contrary_evidence_ids":{"$ref":"#/$defs/texts"},"source_link_ids":{"$ref":"#/$defs/ids"},"review_state":{"enum":["PENDING","APPROVED","REJECTED"]},"reviewer":{"$ref":"#/$defs/nullableText"},"reviewed_at":{"anyOf":[{"$ref":"#/$defs/timestamp"},{"type":"null"}]}}},
    "methodInput":{"type":"object","additionalProperties":false,"required":["input_id","method_application_id","evidence_id","role"],"properties":{"input_id":{"$ref":"#/$defs/text"},"method_application_id":{"$ref":"#/$defs/text"},"evidence_id":{"$ref":"#/$defs/text"},"role":{"$ref":"#/$defs/text"}}},
    "methodOutput":{"type":"object","additionalProperties":false,"required":["output_id","method_application_id","description","provenance"],"properties":{"output_id":{"$ref":"#/$defs/text"},"method_application_id":{"$ref":"#/$defs/text"},"description":{"$ref":"#/$defs/text"},"provenance":{"$ref":"#/$defs/text"}}},
    "methodApplication":{"type":"object","additionalProperties":false,"required":["method_application_id","method_identity","selection_authority","procedure","parameters","input_ids","output_ids","limitation_ids","normative_references","execution_revision"],"properties":{"method_application_id":{"$ref":"#/$defs/text"},"method_identity":{"$ref":"#/$defs/text"},"selection_authority":{"$ref":"#/$defs/text"},"procedure":{"$ref":"#/$defs/text"},"parameters":{"$ref":"#/$defs/texts"},"input_ids":{"$ref":"#/$defs/ids"},"output_ids":{"$ref":"#/$defs/ids"},"limitation_ids":{"$ref":"#/$defs/texts"},"normative_references":{"$ref":"#/$defs/texts"},"execution_revision":{"$ref":"#/$defs/revision"}}},
    "proposal":{"type":"object","additionalProperties":false,"required":["proposal_id","technical_proposition","origin","method_application_ids","supporting_evidence_ids","contrary_evidence_ids","limitation_ids","uncertainty_ids","scope"],"properties":{"proposal_id":{"$ref":"#/$defs/text"},"technical_proposition":{"$ref":"#/$defs/text"},"origin":{"enum":["SOURCE_VALUE","ENGINE_DECISION","AI_PROPOSAL","PROFESSIONAL_PROPOSAL"]},"method_application_ids":{"$ref":"#/$defs/ids"},"supporting_evidence_ids":{"$ref":"#/$defs/ids"},"contrary_evidence_ids":{"$ref":"#/$defs/texts"},"limitation_ids":{"$ref":"#/$defs/ids"},"uncertainty_ids":{"$ref":"#/$defs/ids"},"scope":{"$ref":"#/$defs/text"}}},
    "finding":{"type":"object","additionalProperties":false,"required":["finding_id","proposal_id","decision_id","technical_proposition","scope"],"properties":{"finding_id":{"$ref":"#/$defs/text"},"proposal_id":{"$ref":"#/$defs/text"},"decision_id":{"$ref":"#/$defs/text"},"technical_proposition":{"$ref":"#/$defs/text"},"scope":{"$ref":"#/$defs/text"}}},
    "dependency":{"type":"object","additionalProperties":false,"required":["dependency_id","finding_id","depends_on_finding_id","rationale"],"properties":{"dependency_id":{"$ref":"#/$defs/text"},"finding_id":{"$ref":"#/$defs/text"},"depends_on_finding_id":{"$ref":"#/$defs/text"},"rationale":{"$ref":"#/$defs/text"}}},
    "conflict":{"type":"object","additionalProperties":false,"required":["conflict_id","proposal_id","contrary_evidence_ids","status","resolution_reasoning","decision_id"],"properties":{"conflict_id":{"$ref":"#/$defs/text"},"proposal_id":{"$ref":"#/$defs/text"},"contrary_evidence_ids":{"$ref":"#/$defs/ids"},"status":{"enum":["UNRESOLVED","RESOLVED"]},"resolution_reasoning":{"$ref":"#/$defs/nullableText"},"decision_id":{"$ref":"#/$defs/nullableText"}}},
    "limitation":{"type":"object","additionalProperties":false,"required":["limitation_id","owner_kind","owner_id","kind","description"],"properties":{"limitation_id":{"$ref":"#/$defs/text"},"owner_kind":{"$ref":"#/$defs/text"},"owner_id":{"$ref":"#/$defs/text"},"kind":{"$ref":"#/$defs/text"},"description":{"$ref":"#/$defs/text"}}},
    "uncertainty":{"type":"object","additionalProperties":false,"required":["uncertainty_id","proposal_id","kind","description","impact"],"properties":{"uncertainty_id":{"$ref":"#/$defs/text"},"proposal_id":{"$ref":"#/$defs/text"},"kind":{"$ref":"#/$defs/text"},"description":{"$ref":"#/$defs/text"},"impact":{"$ref":"#/$defs/text"}}},
    "questionLink":{"type":"object","additionalProperties":false,"required":["link_id","question_id","finding_id","relevance"],"properties":{"link_id":{"$ref":"#/$defs/text"},"question_id":{"$ref":"#/$defs/text"},"finding_id":{"$ref":"#/$defs/text"},"relevance":{"$ref":"#/$defs/text"}}},
    "decision":{"type":"object","additionalProperties":false,"required":["decision_id","proposal_id","action","professional_id","reason","modified_proposition","timestamp","supersedes_decision_id"],"properties":{"decision_id":{"$ref":"#/$defs/text"},"proposal_id":{"$ref":"#/$defs/text"},"action":{"enum":["APPROVE","MODIFY","REJECT"]},"professional_id":{"$ref":"#/$defs/text"},"reason":{"$ref":"#/$defs/text"},"modified_proposition":{"$ref":"#/$defs/nullableText"},"timestamp":{"$ref":"#/$defs/timestamp"},"supersedes_decision_id":{"$ref":"#/$defs/nullableText"}}},
    "coverage":{"type":"object","additionalProperties":false,"required":["evidence_items","approved_evidence","method_applications","finding_proposals","effective_findings","unresolved_conflicts","complete","reasons"],"properties":{"evidence_items":{"type":"integer","minimum":0},"approved_evidence":{"type":"integer","minimum":0},"method_applications":{"type":"integer","minimum":0},"finding_proposals":{"type":"integer","minimum":0},"effective_findings":{"type":"integer","minimum":0},"unresolved_conflicts":{"type":"integer","minimum":0},"complete":{"type":"boolean"},"reasons":{"$ref":"#/$defs/texts"}}}
  }
}
