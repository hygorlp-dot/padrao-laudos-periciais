{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://padrao-laudos-periciais.local/schemas/capability-policy-v1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["policyVersion", "analyzerContractVersion", "capabilityClasses", "scanUniverse", "processNamespaceCategories", "mixedNamespaces", "inlineSuppressionsAllowed", "wildcardExceptionsAllowed", "unknownSensitiveReflectionPolicy", "dynamicImportPolicy", "dynamicExecutionPolicy"],
  "properties": {
    "policyVersion": {"const": "1.0.0"}, "analyzerContractVersion": {"const": "1.0.0"},
    "capabilityClasses": {"type": "array", "minItems": 7, "maxItems": 7, "uniqueItems": true, "items": {"enum": ["DYNAMIC_IMPORT_ACQUISITION", "DYNAMIC_EXECUTION_ACQUISITION", "EXECUTABLE_DESERIALIZATION_OR_NATIVE_LOADING", "PROCESS_NAMESPACE_ACQUISITION", "OS_PROCESS_MEMBER_ACQUISITION", "SENSITIVE_NAMESPACE_ESCAPE", "UNKNOWN_SENSITIVE_REFLECTION"]}},
    "scanUniverse": {"type": "object", "additionalProperties": false, "required": ["productionRoots", "classifiedNonProductionRoots", "candidateHeadNewFilesIncluded", "inventoryFailurePolicy", "readParseFailurePolicy"], "properties": {"productionRoots": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-zA-Z0-9_.-]+/$"}}, "classifiedNonProductionRoots": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-zA-Z0-9_.-]+/$"}}, "candidateHeadNewFilesIncluded": {"const": true}, "inventoryFailurePolicy": {"const": "FAIL_CLOSED"}, "readParseFailurePolicy": {"const": "FAIL_CLOSED"}}},
    "processNamespaceCategories": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "mixedNamespaces": {"const": ["os"]},
    "inlineSuppressionsAllowed": {"const": false}, "wildcardExceptionsAllowed": {"const": false}, "unknownSensitiveReflectionPolicy": {"const": "FAIL_CLOSED"},
    "dynamicImportPolicy": {"const": "DENY_UNLESS_EXACT_BASELINE_EXCEPTION"}, "dynamicExecutionPolicy": {"const": "DENY_UNLESS_EXACT_BASELINE_EXCEPTION"}
  }
}
