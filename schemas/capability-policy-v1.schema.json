{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://padrao-laudos-periciais.local/schemas/capability-policy-v1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["policyVersion", "analyzerContractVersion", "capabilityClasses", "scanUniverse", "candidateIdentity", "processNamespaceCategories", "processNamespaces", "dynamicImportSurfaces", "dynamicExecutionSurfaces", "nativeOrExecutableDeserializationSurfaces", "mixedNamespaces", "mixedNamespaceMembers", "ruleMappings", "integrityBootstrap", "inlineSuppressionsAllowed", "wildcardExceptionsAllowed", "unknownSensitiveReflectionPolicy", "dynamicImportPolicy", "dynamicExecutionPolicy"],
  "properties": {
    "policyVersion": {"const": "1.0.0"}, "analyzerContractVersion": {"const": "1.0.0"},
    "capabilityClasses": {"type": "array", "minItems": 7, "maxItems": 7, "uniqueItems": true, "items": {"enum": ["DYNAMIC_IMPORT_ACQUISITION", "DYNAMIC_EXECUTION_ACQUISITION", "EXECUTABLE_DESERIALIZATION_OR_NATIVE_LOADING", "PROCESS_NAMESPACE_ACQUISITION", "OS_PROCESS_MEMBER_ACQUISITION", "SENSITIVE_NAMESPACE_ESCAPE", "UNKNOWN_SENSITIVE_REFLECTION"]}},
    "scanUniverse": {"type": "object", "additionalProperties": false, "required": ["productionRoots", "classifiedNonProductionRoots", "candidateHeadNewFilesIncluded", "inventoryFailurePolicy", "readParseFailurePolicy"], "properties": {"productionRoots": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-zA-Z0-9_.-]+/$"}}, "classifiedNonProductionRoots": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-zA-Z0-9_.-]+/$"}}, "candidateHeadNewFilesIncluded": {"const": true}, "inventoryFailurePolicy": {"const": "FAIL_CLOSED"}, "readParseFailurePolicy": {"const": "FAIL_CLOSED"}}},
    "candidateIdentity": {"type":"object","additionalProperties":false,"required":["requiredInputs","inventorySource","contentSource","commitTreeRelation","identityFailurePolicy"],"properties":{"requiredInputs":{"const":["candidateCommitSha","candidateTreeSha"]},"inventorySource":{"const":"EXACT_GIT_TREE"},"contentSource":{"const":"SAME_EXACT_GIT_TREE"},"commitTreeRelation":{"const":"COMMIT_TREE_MATCH_REQUIRED"},"identityFailurePolicy":{"const":"FAIL_CLOSED"}}},
    "processNamespaceCategories": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "processNamespaces": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},
    "dynamicImportSurfaces": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},
    "dynamicExecutionSurfaces": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},
    "nativeOrExecutableDeserializationSurfaces": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},
    "mixedNamespaces": {"const": ["os", "asyncio", "concurrent.futures", "pickle"]},
    "mixedNamespaceMembers": {"type":"object","additionalProperties":false,"required":["os","asyncio","concurrent.futures","pickle"],"properties":{"os":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},"asyncio":{"const":["create_subprocess_exec","create_subprocess_shell"]},"concurrent.futures":{"const":["ProcessPoolExecutor"]},"pickle":{"const":["load","loads","Unpickler"]}}},
    "ruleMappings": {"type":"array","minItems":7,"maxItems":7,"items":{"type":"object","additionalProperties":false,"required":["findingCode","capabilityClass","severity"],"properties":{"findingCode":{"type":"string"},"capabilityClass":{"type":"string"},"severity":{"enum":["P0","P1"]}}}},
    "integrityBootstrap": {"type":"object","additionalProperties":false,"required":["verifier","activationState","verifierProvenance","workflowProvenance","protectedWorkflow","candidateEnforcementArtifacts","digestAlgorithm","trustRoot","failurePolicy","ordinaryExceptionsMayAuthorizeBootstrap","pinUpdateProtocol","activationRequirements"],"properties":{"verifier":{"const":"CAPABILITY_BOOTSTRAP_V1"},"activationState":{"const":"CONTRACT_ONLY"},"verifierProvenance":{"const":"PROTECTED_BASE_BLOB_NOT_CANDIDATE"},"workflowProvenance":{"const":"PROTECTED_BASE_WORKFLOW"},"protectedWorkflow":{"const":".github/workflows/core-safety.yml"},"candidateEnforcementArtifacts":{"type":"array","minItems":10,"uniqueItems":true,"items":{"type":"string"}},"digestAlgorithm":{"const":"SHA-256"},"trustRoot":{"const":"BRANCH_PROTECTED_PIN_REGISTRY"},"failurePolicy":{"const":"FAIL_CLOSED"},"ordinaryExceptionsMayAuthorizeBootstrap":{"const":false},"pinUpdateProtocol":{"const":"DEDICATED_PR_EXACT_CI_THREE_INDEPENDENT_REVIEWS"},"activationRequirements":{"const":["EXTERNAL_PIN_REGISTRY_WITH_SHA256_PER_ARTIFACT","BOOTSTRAP_IMPLEMENTATION_CAPABILITY_FREE","INERT_TRUST_ANCHOR_PREEXISTS_IN_PROTECTED_BASE","PROTECTED_BASE_LOADS_AND_EXECUTES_VERIFIER","ALL_CANDIDATE_ENFORCEMENT_ARTIFACTS_PINNED","ATOMIC_BLOCKING_CUTOVER"]}}},
    "inlineSuppressionsAllowed": {"const": false}, "wildcardExceptionsAllowed": {"const": false}, "unknownSensitiveReflectionPolicy": {"const": "FAIL_CLOSED"},
    "dynamicImportPolicy": {"const": "DENY_UNLESS_EXACT_BASELINE_EXCEPTION"}, "dynamicExecutionPolicy": {"const": "DENY_UNLESS_EXACT_BASELINE_EXCEPTION"}
  }
}
