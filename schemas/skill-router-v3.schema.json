{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://padrao-laudos-periciais.local/schemas/skill-router-v3.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "precedence", "material_bundle", "condition_requires", "profiles", "reference_only"],
  "properties": {
    "schema_version": {"const": "3.0.0"},
    "precedence": {"const": ["AGENTS.md", "FIRST_PARTY_SKILL", "APPROVED_PRODUCT_PRINCIPLE", "PINNED_THIRD_PARTY_SKILL"]},
    "material_bundle": {"$ref": "#/$defs/skills"},
    "condition_requires": {"const": {"external_review_eligible": ["terminal_head"]}},
    "profiles": {
      "type": "object",
      "propertyNames": {"enum": ["engineering", "assurance", "ui", "case_analysis", "planning_findings", "report"]},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["required", "conditional"],
        "properties": {
          "required": {"$ref": "#/$defs/skills"},
          "conditional": {
            "type": "object",
            "propertyNames": {"enum": ["reproduced_bug", "multi_step", "stable_plan", "dependency_decision", "review_requested", "independent_review_required", "systemic_risk", "external_review_eligible", "polish_requested", "material_claims", "continuous_audit", "terminal_head", "tipo_pericia_vicios", "language_audit", "report_review"]},
            "additionalProperties": {"$ref": "#/$defs/skills"}
          }
        }
      }
    },
    "reference_only": {"$ref": "#/$defs/skills"}
  },
  "$defs": {"skills": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}}}
}
