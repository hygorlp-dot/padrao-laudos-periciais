{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"delivery-snapshot-v1.schema.json","title":"Delivery Snapshot V1","type":"object","additionalProperties":false,
  "required":["schema_version","delivery_id","revision","workspace_id","binding","template_id","template_revision","template_digest","rendering_version","artifacts","package","decisions","state","stale_reasons","supersedes_delivery_id"],
  "properties":{
    "schema_version":{"const":"1.0.0"},"delivery_id":{"$ref":"#/$defs/text"},"revision":{"$ref":"#/$defs/positive"},"workspace_id":{"$ref":"#/$defs/text"},
    "binding":{"$ref":"#/$defs/binding"},"template_id":{"$ref":"#/$defs/text"},"template_revision":{"$ref":"#/$defs/positive"},"template_digest":{"$ref":"#/$defs/digest"},"rendering_version":{"$ref":"#/$defs/text"},
    "artifacts":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/artifact"}},"package":{"$ref":"#/$defs/package"},"decisions":{"type":"array","items":{"$ref":"#/$defs/decision"}},
    "state":{"enum":["DRAFT","READY_FOR_REVIEW","APPROVED","FINALIZED","DELIVERED","SUPERSEDED","STALE"]},"stale_reasons":{"$ref":"#/$defs/texts"},"supersedes_delivery_id":{"anyOf":[{"$ref":"#/$defs/text"},{"type":"null"}]}
  },
  "$defs":{
    "text":{"type":"string","minLength":1,"pattern":".*\\S.*"},"positive":{"type":"integer","minimum":1},"digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"texts":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/text"}},
    "binding":{"type":"object","additionalProperties":false,"required":["workspace_id","source_snapshot_id","source_revision","source_digest","case_analysis_snapshot_id","case_analysis_revision","case_analysis_digest","planning_snapshot_id","planning_revision","planning_digest","inspection_snapshot_id","inspection_revision","inspection_digest","technical_snapshot_id","technical_revision","technical_digest","report_snapshot_id","report_revision","report_digest","report_approval_id","report_approval_digest"],"properties":{
      "workspace_id":{"$ref":"#/$defs/text"},"source_snapshot_id":{"$ref":"#/$defs/text"},"source_revision":{"$ref":"#/$defs/positive"},"source_digest":{"$ref":"#/$defs/digest"},
      "case_analysis_snapshot_id":{"$ref":"#/$defs/text"},"case_analysis_revision":{"$ref":"#/$defs/positive"},"case_analysis_digest":{"$ref":"#/$defs/digest"},
      "planning_snapshot_id":{"$ref":"#/$defs/text"},"planning_revision":{"$ref":"#/$defs/positive"},"planning_digest":{"$ref":"#/$defs/digest"},
      "inspection_snapshot_id":{"$ref":"#/$defs/text"},"inspection_revision":{"$ref":"#/$defs/positive"},"inspection_digest":{"$ref":"#/$defs/digest"},
      "technical_snapshot_id":{"$ref":"#/$defs/text"},"technical_revision":{"$ref":"#/$defs/positive"},"technical_digest":{"$ref":"#/$defs/digest"},
      "report_snapshot_id":{"$ref":"#/$defs/text"},"report_revision":{"$ref":"#/$defs/positive"},"report_digest":{"$ref":"#/$defs/digest"},"report_approval_id":{"$ref":"#/$defs/text"},"report_approval_digest":{"$ref":"#/$defs/digest"}
    }},
    "artifact":{"type":"object","additionalProperties":false,"required":["artifact_id","role","format","filename","content_id","media_type","byte_size","checksum_sha256"],"properties":{"artifact_id":{"$ref":"#/$defs/text"},"role":{"enum":["MAIN_REPORT","ANNEX","PHOTO_APPENDIX","TECHNICAL_APPENDIX","SUPPORTING_FILE"]},"format":{"enum":["DOCX","DOCM","PDF","OTHER"]},"filename":{"$ref":"#/$defs/text"},"content_id":{"type":"string","format":"uuid"},"media_type":{"$ref":"#/$defs/text"},"byte_size":{"type":"integer","minimum":1},"checksum_sha256":{"$ref":"#/$defs/digest"}}},
    "package":{"type":"object","additionalProperties":false,"required":["manifest_version","artifact_ids"],"properties":{"manifest_version":{"const":"1.0.0"},"artifact_ids":{"$ref":"#/$defs/texts"}}},
    "decision":{"type":"object","additionalProperties":false,"required":["decision_id","action","professional_id","reason","timestamp","supersedes_decision_id"],"properties":{"decision_id":{"$ref":"#/$defs/text"},"action":{"enum":["MARK_READY_FOR_REVIEW","APPROVE","FINALIZE","DELIVER","SUPERSEDE"]},"professional_id":{"$ref":"#/$defs/text"},"reason":{"$ref":"#/$defs/text"},"timestamp":{"type":"string","format":"date-time"},"supersedes_decision_id":{"anyOf":[{"$ref":"#/$defs/text"},{"type":"null"}]}}}
  }
}
