{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://padrao-laudos.local/schemas/inspection-session-v1.schema.json",
  "title": "Inspection Session V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","session_id","workspace_id","plan_snapshot","started_at","ended_at","location_context","participant_references","responsible_professional","source_revision","items","observations","statements","measurements","measurement_series","methods","instruments","instrument_statuses","photos","videos","sketches","locations","environmental_conditions","access_occurrences","limitations","missing_items","evidence_candidates","coverage","reviews","upstream_stale","upstream_stale_reasons"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "session_id": {"$ref": "#/$defs/text"},
    "workspace_id": {"type":"string","format":"uuid"},
    "plan_snapshot": {"$ref":"#/$defs/planSnapshot"},
    "started_at": {"type":"string","format":"date-time"},
    "ended_at": {"type":["string","null"],"format":"date-time"},
    "location_context": {"$ref":"#/$defs/text"},
    "participant_references": {"$ref":"#/$defs/textArray"},
    "responsible_professional": {"$ref":"#/$defs/text"},
    "source_revision": {"type":"integer","minimum":1},
    "items": {"type":"array","minItems":1,"items":{"$ref":"#/$defs/record"}},
    "observations": {"type":"array","items":{"$ref":"#/$defs/record"}},
    "statements": {"type":"array","items":{"$ref":"#/$defs/record"}},
    "measurements": {"type":"array","items":{"$ref":"#/$defs/record"}},
    "measurement_series": {"type":"array","items":{"$ref":"#/$defs/record"}},
    "methods": {"type":"array","items":{"$ref":"#/$defs/record"}},
    "instruments": {"type":"array","items":{"$ref":"#/$defs/record"}},
    "instrument_statuses": {"type":"array","items":{"$ref":"#/$defs/record"}},
    "photos": {"type":"array","items":{"$ref":"#/$defs/record"}},
    "videos": {"type":"array","items":{"$ref":"#/$defs/record"}},
    "sketches": {"type":"array","items":{"$ref":"#/$defs/record"}},
    "locations": {"type":"array","minItems":1,"items":{"$ref":"#/$defs/record"}},
    "environmental_conditions": {"type":"array","items":{"$ref":"#/$defs/record"}},
    "access_occurrences": {"type":"array","items":{"$ref":"#/$defs/record"}},
    "limitations": {"type":"array","items":{"$ref":"#/$defs/record"}},
    "missing_items": {"type":"array","items":{"$ref":"#/$defs/record"}},
    "evidence_candidates": {"type":"array","items":{"$ref":"#/$defs/record"}},
    "coverage": {"$ref":"#/$defs/record"},
    "reviews": {"type":"array","items":{"$ref":"#/$defs/record"}},
    "upstream_stale": {"type":"boolean"},
    "upstream_stale_reasons": {"$ref":"#/$defs/textArray"}
  },
  "$defs": {
    "text": {"type":"string","minLength":1},
    "textArray": {"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/text"}},
    "sha256": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "record": {"type":"object","minProperties":1},
    "planSnapshot": {
      "type":"object","additionalProperties":false,
      "required":["plan_id","planning_snapshot_id","planning_revision","planning_digest","workspace_id","approved_item_ids","source_revision"],
      "properties": {
        "plan_id":{"$ref":"#/$defs/text"},"planning_snapshot_id":{"$ref":"#/$defs/text"},
        "planning_revision":{"type":"integer","minimum":1},"planning_digest":{"$ref":"#/$defs/sha256"},
        "workspace_id":{"type":"string","format":"uuid"},"approved_item_ids":{"$ref":"#/$defs/textArray"},
        "source_revision":{"type":"integer","minimum":1}
      }
    }
  }
}
