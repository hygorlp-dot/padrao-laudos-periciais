{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://padrao-laudos.local/schemas/inspection-session-v1.schema.json",
  "title": "Inspection Session V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","session_id","workspace_id","plan_snapshot","started_at","ended_at","location_context","participant_references","responsible_professional","source_revision","items","observations","statements","measurements","measurement_series","methods","instruments","instrument_statuses","photos","videos","sketches","locations","environmental_conditions","access_occurrences","limitations","missing_items","evidence_candidates","coverage","reviews","upstream_stale","upstream_stale_reasons"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "session_id": {"$ref": "#/$defs/text"},
    "workspace_id": {"type":"string","format":"uuid"},
    "plan_snapshot": {"$ref":"#/$defs/planSnapshot"},
    "started_at": {"type":"string","format":"date-time"},
    "ended_at": {"type":["string","null"],"format":"date-time"},
    "location_context": {"$ref":"#/$defs/text"},
    "participant_references": {"$ref":"#/$defs/textArray"},
    "responsible_professional": {"$ref":"#/$defs/text"},
    "source_revision": {"type":"integer","minimum":1},
    "items": {"type":"array","minItems":1,"items":{"$ref":"#/$defs/inspectionItem"}},
    "observations": {"type":"array","items":{"$ref":"#/$defs/fieldObservation"}},
    "statements": {"type":"array","items":{"$ref":"#/$defs/fieldStatement"}},
    "measurements": {"type":"array","items":{"$ref":"#/$defs/measurement"}},
    "measurement_series": {"type":"array","items":{"$ref":"#/$defs/measurementSeries"}},
    "methods": {"type":"array","items":{"$ref":"#/$defs/measurementMethod"}},
    "instruments": {"type":"array","items":{"$ref":"#/$defs/instrument"}},
    "instrument_statuses": {"type":"array","items":{"$ref":"#/$defs/instrumentStatus"}},
    "photos": {"type":"array","items":{"$ref":"#/$defs/photoRecord"}},
    "videos": {"type":"array","items":{"$ref":"#/$defs/videoReference"}},
    "sketches": {"type":"array","items":{"$ref":"#/$defs/sketchReference"}},
    "locations": {"type":"array","minItems":1,"items":{"$ref":"#/$defs/locationReference"}},
    "environmental_conditions": {"type":"array","items":{"$ref":"#/$defs/environmentalCondition"}},
    "access_occurrences": {"type":"array","items":{"$ref":"#/$defs/accessOccurrence"}},
    "limitations": {"type":"array","items":{"$ref":"#/$defs/fieldLimitation"}},
    "missing_items": {"type":"array","items":{"$ref":"#/$defs/missingInspectionItem"}},
    "evidence_candidates": {"type":"array","items":{"$ref":"#/$defs/evidenceCandidate"}},
    "coverage": {"$ref":"#/$defs/coverage"},
    "reviews": {"type":"array","items":{"$ref":"#/$defs/inspectionReview"}},
    "upstream_stale": {"type":"boolean"},
    "upstream_stale_reasons": {"$ref":"#/$defs/textArray"}
  },
  "$defs": {
    "text": {"type":"string","minLength":1},
    "textArray": {"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/text"}},
    "sha256": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "nullableText": {"type":["string","null"],"minLength":1},
    "state": {"enum":["PENDING","COMPLETED","PARTIAL","NOT_EXECUTED","NOT_APPLICABLE","BLOCKED"]},
    "observationType": {"enum":["DIRECT_OBSERVATION","MEASURED_VALUE","DOCUMENT_PRESENTED_ON_SITE","ENVIRONMENTAL_CONDITION","ACCESS_LIMITATION","PROFESSIONAL_NOTE"]},
    "closed": {"type":"object","additionalProperties":false},
    "inspectionItem": {"type":"object","additionalProperties":false,"required":["item_id","planning_item_id","title","state","observation_ids","measurement_ids","photo_ids","limitation_ids","note"],"properties":{"item_id":{"$ref":"#/$defs/text"},"planning_item_id":{"$ref":"#/$defs/text"},"title":{"$ref":"#/$defs/text"},"state":{"$ref":"#/$defs/state"},"observation_ids":{"$ref":"#/$defs/textArray"},"measurement_ids":{"$ref":"#/$defs/textArray"},"photo_ids":{"$ref":"#/$defs/textArray"},"limitation_ids":{"$ref":"#/$defs/textArray"},"note":{"$ref":"#/$defs/nullableText"}}},
    "fieldObservation": {"type":"object","additionalProperties":false,"required":["observation_id","inspection_item_id","observation_type","raw_observation","location_id","timestamp","operator","provenance"],"properties":{"observation_id":{"$ref":"#/$defs/text"},"inspection_item_id":{"$ref":"#/$defs/text"},"observation_type":{"$ref":"#/$defs/observationType"},"raw_observation":{"$ref":"#/$defs/text"},"location_id":{"$ref":"#/$defs/text"},"timestamp":{"type":"string","format":"date-time"},"operator":{"$ref":"#/$defs/text"},"provenance":{"$ref":"#/$defs/text"}}},
    "fieldStatement": {"type":"object","additionalProperties":false,"required":["statement_id","inspection_item_id","observation_type","speaker","declared_role","verbatim_or_summary","capture_kind","timestamp","provenance"],"properties":{"statement_id":{"$ref":"#/$defs/text"},"inspection_item_id":{"$ref":"#/$defs/text"},"observation_type":{"const":"PARTY_STATEMENT_ON_SITE"},"speaker":{"$ref":"#/$defs/text"},"declared_role":{"$ref":"#/$defs/text"},"verbatim_or_summary":{"$ref":"#/$defs/text"},"capture_kind":{"$ref":"#/$defs/text"},"timestamp":{"type":"string","format":"date-time"},"provenance":{"$ref":"#/$defs/text"}}},
    "measurement": {"type":"object","additionalProperties":false,"required":["measurement_id","inspection_item_id","quantity","raw_value","raw_unit","normalized_value","normalized_unit","instrument_id","method_id","location_id","timestamp","operator","uncertainty","raw_observation","provenance"],"properties":{"measurement_id":{"$ref":"#/$defs/text"},"inspection_item_id":{"$ref":"#/$defs/text"},"quantity":{"$ref":"#/$defs/text"},"raw_value":{"$ref":"#/$defs/text"},"raw_unit":{"$ref":"#/$defs/text"},"normalized_value":{"$ref":"#/$defs/nullableText"},"normalized_unit":{"$ref":"#/$defs/nullableText"},"instrument_id":{"$ref":"#/$defs/text"},"method_id":{"$ref":"#/$defs/text"},"location_id":{"$ref":"#/$defs/text"},"timestamp":{"type":"string","format":"date-time"},"operator":{"$ref":"#/$defs/text"},"uncertainty":{"$ref":"#/$defs/nullableText"},"raw_observation":{"$ref":"#/$defs/text"},"provenance":{"$ref":"#/$defs/text"}},"allOf":[{"if":{"properties":{"normalized_value":{"type":"string"}}},"then":{"properties":{"normalized_unit":{"type":"string"}}}},{"if":{"properties":{"normalized_value":{"type":"null"}}},"then":{"properties":{"normalized_unit":{"type":"null"}}}}]},
    "measurementSeries": {"type":"object","additionalProperties":false,"required":["series_id","measurement_ids","purpose"],"properties":{"series_id":{"$ref":"#/$defs/text"},"measurement_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/text"}},"purpose":{"$ref":"#/$defs/text"}}},
    "measurementMethod": {"type":"object","additionalProperties":false,"required":["method_id","name","procedure","provenance"],"properties":{"method_id":{"$ref":"#/$defs/text"},"name":{"$ref":"#/$defs/text"},"procedure":{"$ref":"#/$defs/text"},"provenance":{"$ref":"#/$defs/text"}}},
    "instrument": {"type":"object","additionalProperties":false,"required":["instrument_id","identity","model","serial_number","capability","calibration_claimed","certificate_reference"],"properties":{"instrument_id":{"$ref":"#/$defs/text"},"identity":{"$ref":"#/$defs/text"},"model":{"$ref":"#/$defs/text"},"serial_number":{"$ref":"#/$defs/text"},"capability":{"$ref":"#/$defs/text"},"calibration_claimed":{"type":"boolean"},"certificate_reference":{"$ref":"#/$defs/nullableText"}},"allOf":[{"if":{"properties":{"calibration_claimed":{"const":true}}},"then":{"properties":{"certificate_reference":{"type":"string","minLength":1}}}},{"if":{"properties":{"calibration_claimed":{"const":false}}},"then":{"properties":{"certificate_reference":{"type":"null"}}}}]},
    "instrumentStatus": {"type":"object","additionalProperties":false,"required":["status_id","instrument_id","status","checked_at","evidence_reference"],"properties":{"status_id":{"$ref":"#/$defs/text"},"instrument_id":{"$ref":"#/$defs/text"},"status":{"$ref":"#/$defs/text"},"checked_at":{"type":"string","format":"date-time"},"evidence_reference":{"$ref":"#/$defs/text"}}},
    "photoRecord": {"type":"object","additionalProperties":false,"required":["photo_id","inspection_item_id","private_content_id","original_sha256","reliable_capture_timestamp","location_id","caption","device","provenance"],"properties":{"photo_id":{"$ref":"#/$defs/text"},"inspection_item_id":{"$ref":"#/$defs/text"},"private_content_id":{"type":"string","format":"uuid"},"original_sha256":{"$ref":"#/$defs/sha256"},"reliable_capture_timestamp":{"type":"string","format":"date-time"},"location_id":{"$ref":"#/$defs/text"},"caption":{"$ref":"#/$defs/text"},"device":{"$ref":"#/$defs/text"},"provenance":{"$ref":"#/$defs/text"}}},
    "videoReference": {"type":"object","additionalProperties":false,"required":["video_id","inspection_item_id","private_content_id","original_sha256","caption"],"properties":{"video_id":{"$ref":"#/$defs/text"},"inspection_item_id":{"$ref":"#/$defs/text"},"private_content_id":{"type":"string","format":"uuid"},"original_sha256":{"$ref":"#/$defs/sha256"},"caption":{"$ref":"#/$defs/text"}}},
    "sketchReference": {"type":"object","additionalProperties":false,"required":["sketch_id","inspection_item_id","private_content_id","original_sha256","caption"],"properties":{"sketch_id":{"$ref":"#/$defs/text"},"inspection_item_id":{"$ref":"#/$defs/text"},"private_content_id":{"type":"string","format":"uuid"},"original_sha256":{"$ref":"#/$defs/sha256"},"caption":{"$ref":"#/$defs/text"}}},
    "locationReference": {"type":"object","additionalProperties":false,"required":["location_id","description","parent_location_id"],"properties":{"location_id":{"$ref":"#/$defs/text"},"description":{"$ref":"#/$defs/text"},"parent_location_id":{"$ref":"#/$defs/nullableText"}}},
    "environmentalCondition": {"type":"object","additionalProperties":false,"required":["condition_id","inspection_item_id","description","timestamp","provenance"],"properties":{"condition_id":{"$ref":"#/$defs/text"},"inspection_item_id":{"$ref":"#/$defs/text"},"description":{"$ref":"#/$defs/text"},"timestamp":{"type":"string","format":"date-time"},"provenance":{"$ref":"#/$defs/text"}}},
    "accessOccurrence": {"type":"object","additionalProperties":false,"required":["occurrence_id","inspection_item_id","outcome","description","timestamp"],"properties":{"occurrence_id":{"$ref":"#/$defs/text"},"inspection_item_id":{"$ref":"#/$defs/text"},"outcome":{"$ref":"#/$defs/text"},"description":{"$ref":"#/$defs/text"},"timestamp":{"type":"string","format":"date-time"}}},
    "fieldLimitation": {"type":"object","additionalProperties":false,"required":["limitation_id","inspection_item_id","kind","description","consequence_for_coverage","provenance"],"properties":{"limitation_id":{"$ref":"#/$defs/text"},"inspection_item_id":{"$ref":"#/$defs/text"},"kind":{"enum":["INACCESSIBLE_AREA","IMPOSSIBLE_MEASUREMENT","EQUIPMENT_UNAVAILABLE","ENVIRONMENTAL_CONDITION","PARTY_ABSENCE","DOCUMENT_UNAVAILABLE","UNSAFE_CONDITION","SCOPE_LIMITATION","ACCESS_LIMITATION"]},"description":{"$ref":"#/$defs/text"},"consequence_for_coverage":{"$ref":"#/$defs/text"},"provenance":{"$ref":"#/$defs/text"}}},
    "missingInspectionItem": {"type":"object","additionalProperties":false,"required":["missing_id","planning_item_id","reason","limitation_id"],"properties":{"missing_id":{"$ref":"#/$defs/text"},"planning_item_id":{"$ref":"#/$defs/text"},"reason":{"$ref":"#/$defs/text"},"limitation_id":{"$ref":"#/$defs/text"}}},
    "evidenceCandidate": {"type":"object","additionalProperties":false,"required":["candidate_id","inspection_item_id","source_record_ids","description","provenance"],"properties":{"candidate_id":{"$ref":"#/$defs/text"},"inspection_item_id":{"$ref":"#/$defs/text"},"source_record_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/text"}},"description":{"$ref":"#/$defs/text"},"provenance":{"$ref":"#/$defs/text"}}},
    "coverage": {"type":"object","additionalProperties":false,"required":["total_items","pending_items","completed_items","partial_items","not_executed_items","not_applicable_items","blocked_items","complete","limitation_ids","reasons"],"properties":{"total_items":{"type":"integer","minimum":0},"pending_items":{"type":"integer","minimum":0},"completed_items":{"type":"integer","minimum":0},"partial_items":{"type":"integer","minimum":0},"not_executed_items":{"type":"integer","minimum":0},"not_applicable_items":{"type":"integer","minimum":0},"blocked_items":{"type":"integer","minimum":0},"complete":{"type":"boolean"},"limitation_ids":{"$ref":"#/$defs/textArray"},"reasons":{"$ref":"#/$defs/textArray"}}},
    "inspectionReview": {"type":"object","additionalProperties":false,"required":["review_id","reviewer","reviewed_at","status","notes"],"properties":{"review_id":{"$ref":"#/$defs/text"},"reviewer":{"$ref":"#/$defs/text"},"reviewed_at":{"type":"string","format":"date-time"},"status":{"$ref":"#/$defs/text"},"notes":{"$ref":"#/$defs/text"}}},
    "planSnapshot": {
      "type":"object","additionalProperties":false,
      "required":["plan_id","planning_snapshot_id","planning_revision","planning_digest","workspace_id","approved_item_ids","source_revision"],
      "properties": {
        "plan_id":{"$ref":"#/$defs/text"},"planning_snapshot_id":{"$ref":"#/$defs/text"},
        "planning_revision":{"type":"integer","minimum":1},"planning_digest":{"$ref":"#/$defs/sha256"},
        "workspace_id":{"type":"string","format":"uuid"},"approved_item_ids":{"$ref":"#/$defs/textArray"},
        "source_revision":{"type":"integer","minimum":1}
      }
    }
  }
}
